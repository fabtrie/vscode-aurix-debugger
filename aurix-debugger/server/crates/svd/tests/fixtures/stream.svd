<?xml version="1.0" encoding="utf-8"?>
<!-- What the conversion has to read as the extension did, one peripheral at a time. -->
<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance">
  <name>FIXTURE</name>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <peripherals>
    <peripheral>
      <name>ZETA</name>
      <description>Sorted after the grouped ones: &lt;tx&gt; &amp; &#x41; &#66; &unknown;</description>
      <groupName>G</groupName>
      <baseAddress>0xF0001000</baseAddress>
      <size>16</size>
      <access>read-only</access>
      <addressBlock><offset>0x0</offset><size>0x100</size><usage>registers</usage></addressBlock>
      <addressBlock><offset>0x200</offset><size>0x40</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>CTRL</name>
          <description>Control
            over two lines</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000005</resetValue>
          <fields>
            <field>
              <name>EN</name>
              <description>Enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <name>onoff</name>
                <enumeratedValue><name>OFF</name><description>Off</description><value>0</value></enumeratedValue>
                <enumeratedValue><name>ON</name><value>1</value></enumeratedValue>
                <enumeratedValue><name>DEFAULT</name><isDefault>true</isDefault></enumeratedValue>
                <enumeratedValue><name>ON_AGAIN</name><value>0b1</value></enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MODE</name>
              <description>Named further on in the file</description>
              <bitRange>[3:1]</bitRange>
              <enumeratedValues derivedFrom="LATER"/>
            </field>
            <field>
              <name>FLAG</name>
              <lsb>4</lsb>
              <msb>4</msb>
              <access />
              <readAction>clear</readAction>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>CH%s</name>
              <description>Channel %s</description>
              <dim>2</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>A, B</dimIndex>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues derivedFrom="onoff"/>
            </field>
            <field>
              <name>PATH</name>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues derivedFrom="CTRL.EN.onoff"/>
            </field>
          </fields>
        </register>
        <register>
          <name>DATA[%s]</name>
          <description>Data word %s</description>
          <dim>4</dim>
          <dimIncrement>0x4</dimIncrement>
          <addressOffset>0x10</addressOffset>
          <readAction>modify</readAction>
          <fields>
            <field><name>VALUE</name><bitRange>[31:0]</bitRange><access>write-only</access></field>
          </fields>
        </register>
        <register>
          <name>R%s</name>
          <dim>3</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>3-5</dimIndex>
          <addressOffset>0x20</addressOffset>
        </register>
        <register>
          <name>L%s</name>
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>a-c</dimIndex>
          <addressOffset>0x30</addressOffset>
        </register>
        <register>
          <name>U%s</name>
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>x</dimIndex>
          <addressOffset>0x38</addressOffset>
        </register>
        <register derivedFrom="CTRL">
          <name>ALIAS</name>
          <description><![CDATA[Like CTRL, at <0x40>]]></description>
          <addressOffset>0x40</addressOffset>
        </register>
        <register>
          <name>TWO_FIELDS</name>
          <addressOffset>0x44</addressOffset>
          <fields><field><name>A</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field></fields>
          <fields><field><name>B</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth></field></fields>
        </register>
        <register>
          <name>ODD</name>
          <addressOffset>0x48</addressOffset>
          <size>0x10</size>
          <resetValue>12abc</resetValue>
          <access>writeOnce</access>
          <fields/>
        </register>
        <cluster>
          <name>CL%s</name>
          <description>Cluster %s</description>
          <dim>2</dim>
          <dimIncrement>0x20</dimIncrement>
          <addressOffset>0x100</addressOffset>
          <size>8</size>
          <access>read-writeOnce</access>
          <register>
            <name>X</name>
            <addressOffset>0x0</addressOffset>
            <fields>
              <field>
                <name>K</name>
                <bitOffset>0</bitOffset>
                <bitWidth>2</bitWidth>
                <enumeratedValues>
                  <name>kind</name>
                  <enumeratedValue><name>K0</name><value>0</value></enumeratedValue>
                  <enumeratedValue><name>K2</name><value>2</value></enumeratedValue>
                  <enumeratedValue><name>K10</name><value>10</value></enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <cluster>
            <name>SUB</name>
            <addressOffset>0x10</addressOffset>
            <register><name>Y</name><addressOffset>0x4</addressOffset></register>
          </cluster>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>ALPHA</name>
      <groupName>G</groupName>
      <baseAddress>0xF0002000</baseAddress>
      <registers>
        <cluster>
          <name>ONLY</name>
          <addressOffset>0x8</addressOffset>
          <register><name>Q</name><addressOffset>0x0</addressOffset></register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>LATE</name>
      <baseAddress>0xF0003000</baseAddress>
      <registers>
        <register>
          <name>M</name>
          <addressOffset>0x0</addressOffset>
          <fields>
            <field>
              <name>SEL</name>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                <name>LATER</name>
                <enumeratedValue><name>S0</name><description>First
                  choice</description><value>0x0</value></enumeratedValue>
                <enumeratedValue><name>S7</name><value>#111</value></enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>EMPTY</name>
      <baseAddress>0xF0004000</baseAddress>
      <registers/>
    </peripheral>
  </peripherals>
</device>
