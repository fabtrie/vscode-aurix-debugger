{
	"name": "aurix-debugger",
	"description": "AURIX™ debugger for VS Code",
	"displayName": "AURIX™ Debugger",
	"icon": "media/debugger-icon.png",
	"publisher": "fabtrie",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/fabtrie/vscode-aurix-debugger.git"
	},
	"homepage": "https://github.com/fabtrie/vscode-aurix-debugger",
	"bugs": {
		"url": "https://github.com/fabtrie/vscode-aurix-debugger/issues"
	},
	"license": "MIT",
	"engines": {
		"vscode": "^1.79.0"
	},
	"categories": [
		"Debuggers"
	],
	"keywords": [
		"aurix",
		"tricore",
		"embedded",
		"debugger",
		"vscode",
		"vscode-extension",
		"infineon"
	],
	"activationEvents": [
		"onDebug",
		"onDebugResolve:aurixdbg",
		"onWebviewPanel:aurixLiveWatchPanel"
	],
	"extensionDependencies": [
		"mcu-debug.peripheral-viewer",
		"eclipse-cdt.memory-inspector"
	],
	"main": "./out/extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "Path mapper function execution may be disabled."
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run copy-agent",
		"compile": "tsc -p ./ && node ./scripts/copy-static-assets.js",
		"watch": "tsc -watch -p ./",
		"svd:compress": "node ./scripts/compress-svd.js --delete",
		"svd:hsm": "node ./scripts/gen-hsm-svd.js",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"package": "npx vsce package --target win32-x64 --baseContentUrl https://github.com/fabtrie/vscode-aurix-debugger/blob/main/vscode-aurix-tcf-debugger --baseImagesUrl https://github.com/fabtrie/vscode-aurix-debugger/raw/main/vscode-aurix-tcf-debugger -o aurix-debugger.vsix",
		"release": "npx vsce publish --target win32-x64 --baseContentUrl https://github.com/fabtrie/vscode-aurix-debugger/blob/main/vscode-aurix-tcf-debugger --baseImagesUrl https://github.com/fabtrie/vscode-aurix-debugger/raw/main/vscode-aurix-tcf-debugger",
		"copy-agent": "node ./scripts/copy-agent.js"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.6",
		"@types/node": "20.x",
		"@types/vscode": "^1.79.0",
		"@typescript-eslint/eslint-plugin": "^6.13.2",
		"@typescript-eslint/parser": "^6.13.2",
		"@vscode/test-electron": "^2.3.8",
		"@vscode/vsce": "^2.22.0",
		"eslint": "^8.55.0",
		"mocha": "^10.8.2",
		"mocha-junit-reporter": "^2.2.0",
		"typescript": "^5.3.3"
	},
	"dependencies": {
		"@vscode/debugadapter": "1.64.0",
		"@vscode/debugprotocol": "1.64.0"
	},
	"contributes": {
		"commands": [
			{
				"command": "aurix-debugger.resetTarget",
				"title": "Reset",
				"category": "AURIX™ Debugger",
				"icon": {
					"light": "media/reset-halt-light.svg",
					"dark": "media/reset-halt-dark.svg"
				}
			},
			{
				"command": "aurix-debugger.flashTarget",
				"title": "Flash Target",
				"category": "AURIX™ Debugger",
				"icon": "$(desktop-download)"
			},
			{
				"command": "aurix-debugger.showActions",
				"title": "Debugger Actions",
				"category": "AURIX™ Debugger",
				"icon": "$(tools)"
			},
			{
				"command": "aurix-debugger.runAction",
				"title": "Run Debugger Action",
				"category": "AURIX™ Debugger"
			},
			{
				"command": "aurix-debugger.showResetCapabilities",
				"title": "Show Reset Capabilities",
				"category": "AURIX™ Debugger"
			},
			{
				"command": "aurix-debugger.toggleInstructionStepping",
				"title": "Toggle Instruction Stepping",
				"category": "AURIX™ Debugger"
			},
			{
				"command": "aurix-debugger.enableInstructionStepping",
				"title": "Enable Instruction Stepping",
				"category": "AURIX™ Debugger",
				"icon": {
					"light": "media/instr-step-on-light.svg",
					"dark": "media/instr-step-on-dark.svg"
				}
			},
			{
				"command": "aurix-debugger.disableInstructionStepping",
				"title": "Disable Instruction Stepping",
				"category": "AURIX™ Debugger",
				"icon": {
					"light": "media/instr-step-off-light.svg",
					"dark": "media/instr-step-off-dark.svg"
				}
			},
			{
				"command": "aurix-debugger.disassemblyGoTo",
				"title": "Go to Address or Symbol in Disassembly",
				"category": "AURIX™ Debugger",
				"icon": "$(search)"
			},
			{
				"command": "aurix-debugger.configureLiveWatch",
				"title": "Configure Global Live Update Interval",
				"category": "AURIX™ Debugger",
				"icon": "$(gear)"
			},
			{
				"command": "aurix-debugger.liveWatchAddExpression",
				"title": "Add Live Watch Expression",
				"category": "AURIX™ Debugger",
				"icon": "$(add)"
			},
			{
				"command": "aurix-debugger.liveWatchRemoveExpression",
				"title": "Remove Live Watch Expression",
				"category": "AURIX™ Debugger",
				"icon": "$(close)"
			},
			{
				"command": "aurix-debugger.liveWatchClearExpressions",
				"title": "Clear Live Watch Expressions",
				"category": "AURIX™ Debugger",
				"icon": "$(clear-all)"
			},
			{
				"command": "aurix-debugger.liveWatchRefresh",
				"title": "Refresh Live Watch",
				"category": "AURIX™ Debugger",
				"icon": "$(refresh)"
			},
			{
				"command": "aurix-debugger.liveWatchSetValue",
				"title": "Set Live Watch Value",
				"category": "AURIX™ Debugger",
				"icon": "$(edit)"
			},
			{
				"command": "aurix-debugger.liveWatchPauseExpression",
				"title": "Pause Updates",
				"category": "AURIX™ Debugger",
				"icon": "$(debug-pause)"
			},
			{
				"command": "aurix-debugger.liveWatchResumeExpression",
				"title": "Resume Updates",
				"category": "AURIX™ Debugger",
				"icon": "$(debug-start)"
			},
			{
				"command": "aurix-debugger.liveWatchCopyValue",
				"title": "Copy Value",
				"category": "AURIX™ Debugger"
			},
			{
				"command": "aurix-debugger.liveWatchCopyExpression",
				"title": "Copy as Expression",
				"category": "AURIX™ Debugger"
			},
			{
				"command": "aurix-debugger.liveWatchEditExpression",
				"title": "Edit Expression",
				"category": "AURIX™ Debugger"
			},
			{
				"command": "aurix-debugger.liveWatchAddPeripheral",
				"title": "Add to Live Watch",
				"category": "AURIX™ Debugger",
				"icon": "$(eye)"
			},
			{
				"command": "aurix-debugger.liveWatchOpenPanel",
				"title": "Open Live Watch Panel...",
				"category": "AURIX™ Debugger",
				"icon": "$(multiple-windows)"
			},
			{
				"command": "aurix-debugger.liveWatchConfigureInterval",
				"title": "Configure Live Watch Refresh Interval",
				"category": "AURIX™ Debugger",
				"icon": "$(gear)"
			},
			{
				"command": "aurix-debugger.liveWatchPanelAddExpression",
				"title": "Add Live Watch Expression",
				"category": "AURIX™ Debugger",
				"icon": "$(add)"
			},
			{
				"command": "aurix-debugger.liveWatchPanelRefresh",
				"title": "Refresh Live Watch",
				"category": "AURIX™ Debugger",
				"icon": "$(refresh)"
			},
			{
				"command": "aurix-debugger.liveWatchPanelConfigureInterval",
				"title": "Configure Live Watch Refresh Interval",
				"category": "AURIX™ Debugger",
				"icon": "$(gear)"
			},
			{
				"command": "aurix-debugger.liveWatchPanelClearExpressions",
				"title": "Clear Live Watch Expressions",
				"category": "AURIX™ Debugger",
				"icon": "$(clear-all)"
			},
			{
				"command": "aurix-debugger.liveWatchPanelRename",
				"title": "Rename Live Watch Panel",
				"category": "AURIX™ Debugger"
			},
			{
				"command": "aurix-debugger.liveWatchPanelMoveToNewWindow",
				"title": "Move Live Watch Panel into New Window",
				"category": "AURIX™ Debugger",
				"icon": "$(empty-window)"
			},
			{
				"command": "aurix-debugger.osRefresh",
				"title": "Refresh AUTOSAR OS",
				"category": "AURIX™ Debugger",
				"icon": "$(refresh)"
			},
			{
				"command": "aurix-debugger.osLoadFile",
				"title": "Load ORTI File…",
				"category": "AURIX™ Debugger",
				"icon": "$(folder-opened)"
			},
			{
				"command": "aurix-debugger.osShowObjects",
				"title": "Show AUTOSAR OS Objects",
				"category": "AURIX™ Debugger",
				"icon": "$(table)"
			},
			{
				"command": "aurix-debugger.osBreakInTask",
				"title": "Halt Only in Task…",
				"category": "AURIX™ Debugger"
			},
			{
				"command": "aurix-debugger.breakOnCore",
				"title": "Halt Only on Core…",
				"category": "AURIX™ Debugger"
			},
			{
				"command": "aurix-debugger.resetDebugLayout",
				"title": "Reset Debug Layout",
				"category": "AURIX™ Debugger"
			},
			{
				"command": "aurix-debugger.osShowProfile",
				"title": "Show OS Profile",
				"category": "AURIX™ Debugger",
				"icon": "$(graph)"
			},
			{
				"command": "aurix-debugger.osTogglePause",
				"title": "Pause AUTOSAR OS Updates",
				"category": "AURIX™ Debugger",
				"icon": "$(debug-pause)"
			}
		],
		"views": {
			"debug": [
				{
					"type": "webview",
					"id": "aurixLiveWatch",
					"name": "Live Watch",
					"icon": "media/debugger-icon.png",
					"when": "debugType == aurixdbg"
				},
				{
					"type": "tree",
					"id": "aurixAutosarOs",
					"name": "AUTOSAR OS",
					"icon": "media/debugger-icon.png",
					"when": "debugType == aurixdbg"
				}
			]
		},
		"menus": {
			"debug/toolBar": [
				{
					"command": "aurix-debugger.flashTarget",
					"when": "debugType == aurixdbg",
					"group": "navigation"
				},
				{
					"command": "aurix-debugger.resetTarget",
					"when": "debugType == aurixdbg",
					"group": "navigation"
				},
				{
					"command": "aurix-debugger.showActions",
					"when": "debugType == aurixdbg && aurix-debugger.hasActions",
					"group": "navigation"
				},
				{
					"command": "aurix-debugger.enableInstructionStepping",
					"when": "debugType == aurixdbg && !aurix-debugger.instructionStepping",
					"group": "navigation"
				},
				{
					"command": "aurix-debugger.disableInstructionStepping",
					"when": "debugType == aurixdbg && aurix-debugger.instructionStepping",
					"group": "navigation"
				}
			],
			"editor/title": [
				{
					"command": "aurix-debugger.disassemblyGoTo",
					"when": "debugType == aurixdbg && debugState == stopped && activeEditor == workbench.debug.disassemblyView",
					"group": "navigation"
				},
				{
					"command": "aurix-debugger.liveWatchPanelAddExpression",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'",
					"group": "navigation@1"
				},
				{
					"command": "aurix-debugger.liveWatchPanelRefresh",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'",
					"group": "navigation@3"
				},
				{
					"command": "aurix-debugger.liveWatchPanelConfigureInterval",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'",
					"group": "navigation@4"
				},
				{
					"command": "aurix-debugger.liveWatchPanelClearExpressions",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'",
					"group": "navigation@9"
				},
				{
					"command": "aurix-debugger.liveWatchPanelRename",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'",
					"group": "1_liveWatch@1"
				},
				{
					"command": "aurix-debugger.liveWatchPanelMoveToNewWindow",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'",
					"group": "1_liveWatch@2"
				}
			],
			"commandPalette": [
				{
					"command": "aurix-debugger.disassemblyGoTo",
					"when": "debugType == aurixdbg && debugState == stopped"
				},
				{
					"command": "aurix-debugger.showActions",
					"when": "debugType == aurixdbg"
				},
				{
					"command": "aurix-debugger.runAction",
					"when": "false"
				},
				{
					"command": "aurix-debugger.liveWatchPauseExpression",
					"when": "false"
				},
				{
					"command": "aurix-debugger.liveWatchResumeExpression",
					"when": "false"
				},
				{
					"command": "aurix-debugger.liveWatchSetValue",
					"when": "false"
				},
				{
					"command": "aurix-debugger.liveWatchRemoveExpression",
					"when": "false"
				},
				{
					"command": "aurix-debugger.liveWatchCopyValue",
					"when": "false"
				},
				{
					"command": "aurix-debugger.liveWatchCopyExpression",
					"when": "false"
				},
				{
					"command": "aurix-debugger.liveWatchEditExpression",
					"when": "false"
				},
				{
					"command": "aurix-debugger.liveWatchAddPeripheral",
					"when": "false"
				},
				{
					"command": "aurix-debugger.liveWatchPanelAddExpression",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'"
				},
				{
					"command": "aurix-debugger.liveWatchPanelRefresh",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'"
				},
				{
					"command": "aurix-debugger.liveWatchPanelConfigureInterval",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'"
				},
				{
					"command": "aurix-debugger.liveWatchPanelClearExpressions",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'"
				},
				{
					"command": "aurix-debugger.liveWatchPanelRename",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'"
				},
				{
					"command": "aurix-debugger.liveWatchPanelMoveToNewWindow",
					"when": "activeWebviewPanelId == 'aurixLiveWatchPanel'"
				}
			],
			"view/title": [
				{
					"command": "aurix-debugger.liveWatchAddExpression",
					"when": "view == aurixLiveWatch",
					"group": "navigation@1"
				},
				{
					"command": "aurix-debugger.liveWatchRefresh",
					"when": "view == aurixLiveWatch",
					"group": "navigation@3"
				},
				{
					"command": "aurix-debugger.liveWatchConfigureInterval",
					"when": "view == aurixLiveWatch",
					"group": "navigation@4"
				},
				{
					"command": "aurix-debugger.liveWatchOpenPanel",
					"when": "view == aurixLiveWatch",
					"group": "navigation@5"
				},
				{
					"command": "aurix-debugger.liveWatchClearExpressions",
					"when": "view == aurixLiveWatch",
					"group": "navigation@9"
				},
				{
					"command": "aurix-debugger.osShowObjects",
					"when": "view == aurixAutosarOs",
					"group": "navigation@1"
				},
				{
					"command": "aurix-debugger.osRefresh",
					"when": "view == aurixAutosarOs",
					"group": "navigation@2"
				},
				{
					"command": "aurix-debugger.osLoadFile",
					"when": "view == aurixAutosarOs",
					"group": "navigation@3"
				},
				{
					"command": "aurix-debugger.osShowProfile",
					"when": "view == aurixAutosarOs",
					"group": "navigation@2"
				},
				{
					"command": "aurix-debugger.osTogglePause",
					"when": "view == aurixAutosarOs",
					"group": "navigation@4"
				}
			],
			"webview/context": [
				{
					"command": "aurix-debugger.liveWatchEditExpression",
					"when": "webviewId =~ /^aurixLiveWatch(Panel)?$/ && webviewSection =~ /^liveWatch\\.root\\.(live|paused)$/",
					"group": "1_edit@0"
				},
				{
					"command": "aurix-debugger.liveWatchSetValue",
					"when": "webviewId =~ /^aurixLiveWatch(Panel)?$/ && webviewSection =~ /^liveWatch\\.(root\\.(live|paused)(\\.register)?|child)$/",
					"group": "1_edit@1"
				},
				{
					"command": "aurix-debugger.liveWatchCopyValue",
					"when": "webviewId =~ /^aurixLiveWatch(Panel)?$/ && webviewSection =~ /^liveWatch\\.(root|child)/",
					"group": "2_copy@1"
				},
				{
					"command": "aurix-debugger.liveWatchCopyExpression",
					"when": "webviewId =~ /^aurixLiveWatch(Panel)?$/ && webviewSection =~ /^liveWatch\\.(root|child)/",
					"group": "2_copy@2"
				},
				{
					"command": "aurix-debugger.liveWatchPauseExpression",
					"when": "webviewId =~ /^aurixLiveWatch(Panel)?$/ && webviewSection =~ /^liveWatch\\.root\\.live/",
					"group": "3_updates@1"
				},
				{
					"command": "aurix-debugger.liveWatchResumeExpression",
					"when": "webviewId =~ /^aurixLiveWatch(Panel)?$/ && webviewSection =~ /^liveWatch\\.root\\.paused/",
					"group": "3_updates@1"
				},
				{
					"command": "aurix-debugger.liveWatchRemoveExpression",
					"when": "webviewId =~ /^aurixLiveWatch(Panel)?$/ && webviewSection =~ /^liveWatch\\.root/",
					"group": "4_remove@1"
				}
			],
			"view/item/context": [
				{
					"command": "aurix-debugger.liveWatchAddPeripheral",
					"when": "view == mcu-debug.peripheral-viewer.svd && debugType == aurixdbg && viewItem =~ /^(register|registerRW|registerRO|field|fieldRO)$/",
					"group": "aurix@1"
				}
			],
			"editor/context": [
				{
					"command": "aurix-debugger.osBreakInTask",
					"when": "debugType == aurixdbg && editorTextFocus",
					"group": "debug@1"
				},
				{
					"command": "aurix-debugger.breakOnCore",
					"when": "debugType == aurixdbg && editorTextFocus",
					"group": "debug@2"
				}
			],
			"editor/lineNumber/context": [
				{
					"command": "aurix-debugger.osBreakInTask",
					"when": "debugType == aurixdbg",
					"group": "aurix@1"
				},
				{
					"command": "aurix-debugger.breakOnCore",
					"when": "debugType == aurixdbg",
					"group": "aurix@2"
				}
			]
		},
		"keybindings": [
			{
				"command": "aurix-debugger.disassemblyGoTo",
				"key": "ctrl+g",
				"when": "debugType == aurixdbg && debugState == stopped && disassemblyViewFocus"
			}
		],
		"configuration": {
			"title": "AURIX™ Debugger",
			"properties": {
				"aurix-debugger.executePathMapper": {
					"type": "boolean",
					"default": true,
					"description": "Execute path mapper function, if defined in launch configuration."
				},
				"aurix-debugger.agentPath": {
					"type": "string",
					"description": "Path to aurix-dbg.exe. Overrides the aurix-dbg bundled with the extension (launch configuration \"agentPath\" takes precedence)."
				},
				"aurix-debugger.autoStartAgent": {
					"type": "boolean",
					"default": false,
					"description": "Automatically start aurix-dbg when a debug session starts."
				},
				"aurix-debugger.rememberDebugLayout": {
					"type": "boolean",
					"default": true,
					"description": "When the last AURIX debug session ends, remember where the debug tabs were (Disassembly, Live Watch panels, OS panels, Memory Inspector editors), close them, and reopen them in the same editor groups and sizes when the next session starts. \"Reset Debug Layout\" forgets the remembered layout."
				},
				"aurix-debugger.autoOpenDisassemblyView": {
					"type": "boolean",
					"default": true,
					"description": "Automatically open the VS Code Disassembly view when an AURIX debug session starts."
				},
				"aurix-debugger.disassembly.opcodeBytes": {
					"type": "string",
					"enum": [
						"left",
						"right",
						"hidden"
					],
					"enumDescriptions": [
						"Show the opcode bytes between the address and the instruction.",
						"Show the opcode bytes after the instruction.",
						"Do not show the opcode bytes."
					],
					"default": "left",
					"description": "Where the Disassembly view shows the opcode bytes of each instruction. Applies to instructions loaded after the change (after the next stop)."
				},
				"aurix-debugger.autoLockDisassemblyView": {
					"type": "boolean",
					"default": true,
					"description": "Lock the Disassembly view editor group after opening it."
				},
				"aurix-debugger.autoEvenEditorWidths": {
					"type": "boolean",
					"default": true,
					"description": "Evenly size editor groups after opening the Disassembly view."
				},
				"aurix-debugger.instructionSteppingDefault": {
					"type": "boolean",
					"default": false,
					"description": "Default state for instruction-level stepping when a debug session starts."
				},
				"aurix-debugger.liveWatch.intervalMs": {
					"type": "number",
					"default": 1000,
					"minimum": 200,
					"description": "How often the live views re-read the target while it runs: the Live Watch, the AUTOSAR OS view and the OS Objects panel. A Live Watch can have its own interval (its gear button), which this one then leaves alone. A view that is not on screen reads nothing."
				}
			}
		},
		"languages": [
			{
				"id": "gtm-mcs-asm",
				"aliases": [
					"GTM MCS Assembler"
				],
				"extensions": [
					".asm"
				]
			}
		],
		"breakpoints": [
			{
				"language": "c"
			},
			{
				"language": "cpp"
			},
			{
