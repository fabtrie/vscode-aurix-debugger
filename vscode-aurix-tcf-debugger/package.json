{
  "name": "vscode-aurix-tcf-debug",
  "description": "AURIX™ Target Communication Framework (TCF) debugger",
  "displayName": "AURIX™ TCF Debugger",
  "icon": "media/debugger-icon.png",
  "publisher": "zehuazhang",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeZhan/vscode-aurix-tcf-debugger.git"
  },
  "homepage": "https://github.com/ZeZhan/vscode-aurix-tcf-debugger",
  "bugs": {
    "url": "https://github.com/ZeZhan/vscode-aurix-tcf-debugger/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Debuggers"
  ],
  "keywords": [
    "aurix",
    "tricore",
    "embedded",
    "debugger",
    "vscode",
    "tcf",
    "tcf-dap",
    "vscode-extension",
    "infineon"
  ],
  "activationEvents": [
    "onDebug",
    "onDebugResolve:aurix-tcf"
  ],
  "extensionDependencies": [
    "mcu-debug.peripheral-viewer",
    "eclipse-cdt.memory-inspector"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Path mapper function execution may be disabled."
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node ./scripts/copy-static-assets.js",
    "watch": "tsc -watch -p ./",
    "svd:compress": "node ./scripts/compress-svd.js --delete",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:stress": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-stress.ps1",
    "package": "npx vsce package --no-rewrite-relative-links -o vscode-aurix-tcf-debug.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@types/vscode": "^1.79.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.55.0",
    "mocha": "^10.8.2",
    "mocha-junit-reporter": "^2.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@vscode/debugadapter": "1.64.0",
    "@vscode/debugprotocol": "1.64.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "aurix-tcf.openDebugConfig",
        "title": "Open Debug Configuration",
        "category": "AURIX™ TCF"
      },
      {
        "command": "aurix-tcf.pickSvd",
        "title": "Pick SVD File",
        "category": "AURIX™ TCF"
      },
      {
        "command": "aurix-tcf.resetTarget",
        "title": "Reset",
        "category": "AURIX™ TCF",
        "icon": {
          "light": "media/reset-halt-light.svg",
          "dark": "media/reset-halt-dark.svg"
        }
      },
      {
        "command": "aurix-tcf.flashTarget",
        "title": "Flash Target",
        "category": "AURIX™ TCF",
        "icon": "$(desktop-download)"
      },
      {
        "command": "aurix-tcf.showActions",
        "title": "Debugger Actions",
        "category": "AURIX™ TCF",
        "icon": "$(tools)"
      },
      {
        "command": "aurix-tcf.runAction",
        "title": "Run Debugger Action",
        "category": "AURIX™ TCF"
      },
      {
        "command": "aurix-tcf.showResetCapabilities",
        "title": "Show Reset Capabilities",
        "category": "AURIX™ TCF"
      },
      {
        "command": "aurix-tcf.toggleInstructionStepping",
        "title": "Toggle Instruction Stepping",
        "category": "AURIX™ TCF"
      },
      {
        "command": "aurix-tcf.enableInstructionStepping",
        "title": "Enable Instruction Stepping",
        "category": "AURIX™ TCF",
        "icon": {
          "light": "media/instr-step-on-light.svg",
          "dark": "media/instr-step-on-dark.svg"
        }
      },
      {
        "command": "aurix-tcf.disableInstructionStepping",
        "title": "Disable Instruction Stepping",
        "category": "AURIX™ TCF",
        "icon": {
          "light": "media/instr-step-off-light.svg",
          "dark": "media/instr-step-off-dark.svg"
        }
      },
      {
        "command": "aurix-tcf.disassemblyGoTo",
        "title": "Go to Address or Symbol in Disassembly",
        "category": "AURIX™ TCF",
        "icon": "$(search)"
      },
      {
        "command": "aurix-tcf.toggleLiveWatch",
        "title": "Toggle Live Watch",
        "category": "AURIX™ TCF"
      },
      {
        "command": "aurix-tcf.configureLiveWatch",
        "title": "Configure Live Watch",
        "category": "AURIX™ TCF",
        "icon": "$(gear)"
      },
      {
        "command": "aurix-tcf.liveWatchAddExpression",
        "title": "Add Live Watch Expression",
        "category": "AURIX™ TCF",
        "icon": "$(add)"
      },
      {
        "command": "aurix-tcf.liveWatchRemoveExpression",
        "title": "Remove Live Watch Expression",
        "category": "AURIX™ TCF",
        "icon": "$(close)"
      },
      {
        "command": "aurix-tcf.liveWatchClearExpressions",
        "title": "Clear Live Watch Expressions",
        "category": "AURIX™ TCF",
        "icon": "$(clear-all)"
      },
      {
        "command": "aurix-tcf.liveWatchRefresh",
        "title": "Refresh Live Watch",
        "category": "AURIX™ TCF",
        "icon": "$(refresh)"
      },
      {
        "command": "aurix-tcf.liveWatchSetValue",
        "title": "Set Live Watch Value",
        "category": "AURIX™ TCF",
        "icon": "$(edit)"
      },
      {
        "command": "aurix-tcf.liveWatchPauseExpression",
        "title": "Pause Updates",
        "category": "AURIX™ TCF",
        "icon": "$(debug-pause)"
      },
      {
        "command": "aurix-tcf.liveWatchResumeExpression",
        "title": "Resume Updates",
        "category": "AURIX™ TCF",
        "icon": "$(debug-start)"
      },
      {
        "command": "aurix-tcf.liveWatchDisableRefresh",
        "title": "Pause Live Watch Refresh",
        "category": "AURIX™ TCF",
        "icon": "$(debug-pause)"
      },
      {
        "command": "aurix-tcf.liveWatchEnableRefresh",
        "title": "Resume Live Watch Refresh",
        "category": "AURIX™ TCF",
        "icon": "$(debug-start)"
      },
      {
        "command": "aurix-tcf.liveWatchCopyValue",
        "title": "Copy Value",
        "category": "AURIX™ TCF"
      },
      {
        "command": "aurix-tcf.liveWatchCopyExpression",
        "title": "Copy as Expression",
        "category": "AURIX™ TCF"
      },
      {
        "command": "aurix-tcf.liveWatchEditExpression",
        "title": "Edit Expression",
        "category": "AURIX™ TCF"
      },
      {
        "command": "aurix-tcf.liveWatchAddPeripheral",
        "title": "Add to Live Watch",
        "category": "AURIX™ TCF",
        "icon": "$(eye)"
      }
    ],
    "views": {
      "debug": [
        {
          "type": "webview",
          "id": "aurixTcfLiveWatch",
          "name": "Live Watch",
          "icon": "media/debugger-icon.png",
          "when": "debugType == aurix-tcf"
        }
      ]
    },
    "menus": {
      "debug/toolBar": [
        {
          "command": "aurix-tcf.flashTarget",
          "when": "debugType == aurix-tcf",
          "group": "navigation"
        },
        {
          "command": "aurix-tcf.resetTarget",
          "when": "debugType == aurix-tcf",
          "group": "navigation"
        },
        {
          "command": "aurix-tcf.showActions",
          "when": "debugType == aurix-tcf && aurix-tcf.hasActions",
          "group": "navigation"
        },
        {
          "command": "aurix-tcf.enableInstructionStepping",
          "when": "debugType == aurix-tcf && !aurix-tcf.instructionStepping",
          "group": "navigation"
        },
        {
          "command": "aurix-tcf.disableInstructionStepping",
          "when": "debugType == aurix-tcf && aurix-tcf.instructionStepping",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "aurix-tcf.disassemblyGoTo",
          "when": "debugType == aurix-tcf && debugState == stopped && activeEditor == workbench.debug.disassemblyView",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "aurix-tcf.disassemblyGoTo",
          "when": "debugType == aurix-tcf && debugState == stopped"
        },
        {
          "command": "aurix-tcf.showActions",
          "when": "debugType == aurix-tcf"
        },
        {
          "command": "aurix-tcf.runAction",
          "when": "false"
        },
        {
          "command": "aurix-tcf.liveWatchPauseExpression",
          "when": "false"
        },
        {
          "command": "aurix-tcf.liveWatchResumeExpression",
          "when": "false"
        },
        {
          "command": "aurix-tcf.liveWatchSetValue",
          "when": "false"
        },
        {
          "command": "aurix-tcf.liveWatchRemoveExpression",
          "when": "false"
        },
        {
          "command": "aurix-tcf.liveWatchCopyValue",
          "when": "false"
        },
        {
          "command": "aurix-tcf.liveWatchCopyExpression",
          "when": "false"
        },
        {
          "command": "aurix-tcf.liveWatchEditExpression",
          "when": "false"
        },
        {
          "command": "aurix-tcf.liveWatchAddPeripheral",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "aurix-tcf.liveWatchAddExpression",
          "when": "view == aurixTcfLiveWatch",
          "group": "navigation@1"
        },
        {
          "command": "aurix-tcf.liveWatchDisableRefresh",
          "when": "view == aurixTcfLiveWatch && aurix-tcf.liveWatchEnabled",
          "group": "navigation@2"
        },
        {
          "command": "aurix-tcf.liveWatchEnableRefresh",
          "when": "view == aurixTcfLiveWatch && !aurix-tcf.liveWatchEnabled",
          "group": "navigation@2"
        },
        {
          "command": "aurix-tcf.liveWatchRefresh",
          "when": "view == aurixTcfLiveWatch",
          "group": "navigation@3"
        },
        {
          "command": "aurix-tcf.configureLiveWatch",
          "when": "view == aurixTcfLiveWatch",
          "group": "navigation@4"
        },
        {
          "command": "aurix-tcf.liveWatchClearExpressions",
          "when": "view == aurixTcfLiveWatch",
          "group": "navigation@9"
        }
      ],
      "webview/context": [
        {
          "command": "aurix-tcf.liveWatchEditExpression",
          "when": "webviewId == 'aurixTcfLiveWatch' && webviewSection =~ /^liveWatch\\.root\\.(live|paused)$/",
          "group": "1_edit@0"
        },
        {
          "command": "aurix-tcf.liveWatchSetValue",
          "when": "webviewId == 'aurixTcfLiveWatch' && webviewSection =~ /^liveWatch\\.(root\\.(live|paused)(\\.register)?|child)$/",
          "group": "1_edit@1"
        },
        {
          "command": "aurix-tcf.liveWatchCopyValue",
          "when": "webviewId == 'aurixTcfLiveWatch' && webviewSection =~ /^liveWatch\\.(root|child)/",
          "group": "2_copy@1"
        },
        {
          "command": "aurix-tcf.liveWatchCopyExpression",
          "when": "webviewId == 'aurixTcfLiveWatch' && webviewSection =~ /^liveWatch\\.(root|child)/",
          "group": "2_copy@2"
        },
        {
          "command": "aurix-tcf.liveWatchPauseExpression",
          "when": "webviewId == 'aurixTcfLiveWatch' && webviewSection =~ /^liveWatch\\.root\\.live/",
          "group": "3_updates@1"
        },
        {
          "command": "aurix-tcf.liveWatchResumeExpression",
          "when": "webviewId == 'aurixTcfLiveWatch' && webviewSection =~ /^liveWatch\\.root\\.paused/",
          "group": "3_updates@1"
        },
        {
          "command": "aurix-tcf.liveWatchRemoveExpression",
          "when": "webviewId == 'aurixTcfLiveWatch' && webviewSection =~ /^liveWatch\\.root/",
          "group": "4_remove@1"
        }
      ],
      "view/item/context": [
        {
          "command": "aurix-tcf.liveWatchAddPeripheral",
          "when": "view == mcu-debug.peripheral-viewer.svd && debugType == aurix-tcf && viewItem =~ /^(register|registerRW|registerRO|field|fieldRO)$/",
          "group": "aurix-tcf@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aurix-tcf.disassemblyGoTo",
        "key": "ctrl+g",
        "when": "debugType == aurix-tcf && debugState == stopped && disassemblyViewFocus"
      }
    ],
    "configuration": {
      "title": "AURIX™ TCF Debugger",
      "properties": {
        "aurix-tcf.executePathMapper": {
          "type": "boolean",
          "default": true,
          "description": "Execute path mapper function, if defined in launch configuration."
        },
        "aurix-tcf.agentPath": {
          "type": "string",
          "description": "Path to the TCF agent executable. If not specified, assumes agent is already running."
        },
        "aurix-tcf.autoStartAgent": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the TCF agent when debugging session starts."
        },
        "aurix-tcf.autoOpenDisassemblyView": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the VS Code Disassembly view when an AURIX TCF debug session starts."
        },
        "aurix-tcf.disassembly.opcodeBytes": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "hidden"
          ],
          "enumDescriptions": [
            "Show the opcode bytes between the address and the instruction.",
            "Show the opcode bytes after the instruction.",
            "Do not show the opcode bytes."
          ],
          "default": "left",
          "description": "Where the Disassembly view shows the opcode bytes of each instruction. Applies to instructions loaded after the change (after the next stop)."
        },
        "aurix-tcf.autoLockDisassemblyView": {
          "type": "boolean",
          "default": true,
          "description": "Lock the Disassembly view editor group after opening it."
        },
        "aurix-tcf.autoEvenEditorWidths": {
          "type": "boolean",
          "default": true,
          "description": "Evenly size editor groups after opening the Disassembly view."
        },
        "aurix-tcf.instructionSteppingDefault": {
          "type": "boolean",
          "default": false,
          "description": "Default state for instruction-level stepping when a debug session starts."
        },
        "aurix-tcf.liveWatch.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Periodically refresh running global watch expressions. Local/frame-dependent watch expressions remain unchanged until the target stops."
        },
        "aurix-tcf.liveWatch.intervalMs": {
          "type": "number",
          "default": 1000,
          "minimum": 200,
          "description": "Refresh interval in milliseconds for running global watch expressions. Minimum 200ms+ is recommended and enforced."
        }
      }
    },
    "languages": [
      {
        "id": "gtm-mcs-asm",
        "aliases": [
          "GTM MCS Assembler"
        ],
        "extensions": [
          ".asm"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "c"
      },
      {
        "language": "cpp"
      },
      {
        "language": "gtm-mcs-asm"
      }
    ],
    "debuggers": [
      {
        "type": "aurix-tcf",
        "label": "AURIX™ TCF Debugger",
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "program": {
                "description": "Path to the ELF executable to debug",
                "type": "string"
              },
              "workspace": {
                "description": "Workspace or project path",
                "type": "string"
              },
              "enableFlashing": {
                "description": "If true, runs the bundled aurixflasher.exe with -elf <program> before starting the debug session (agentFlavor aurix-dbg: programs flashFiles with the server's 'flash write_images', then resets)",
                "type": "boolean",
                "default": false
              },
              "flashFiles": {
                "description": "agentFlavor aurix-dbg: images to program when enableFlashing is true or with the Flash Target toolbar button (ELF, Intel HEX or binary). The files are merged into one image first; where they overlap, later files win. Defaults to [program]. Use the post-build HEX if the build patches CRCs or fills gaps after linking.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "verifyFlash": {
                "description": "agentFlavor aurix-dbg: read the programmed sectors back after flashing and compare them with the image (unchanged sectors are compared while flashing anyway).",
                "type": "boolean",
                "default": true
              },
              "targetDevice": {
                "description": "Target device name (must match lsmcdd.exe output; numeric ids are not supported). Used for agent -p and to resolve aurixflasher -id when enableFlashing is true.",
                "type": "string"
              },
              "entryFunction": {
                "description": "Entry function name (e.g., core0_main)",
                "type": "string"
              },
              "svdFile": {
                "description": "Path to SVD (System View Description) file for register definitions. Supports ${command:aurix-tcf.pickSvd}.",
                "type": "string"
              },
              "ppuElfPath": {
                "description": "Path to the PPU ELF executable",
                "type": "string"
              },
              "cdspElfPaths": {
                "description": "List of CDSP ELF executables (12 cores)",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scrElfPath": {
                "description": "Path to the SCR ELF executable",
                "type": "string"
              },
              "symbolFiles": {
                "description": "Additional symbol files (e.g. bootmanager, FBL, HSM ELF files, GTM MCS assembler sources). Symbols only: they are never flashed. Without \"cores\", a file applies to every core of its architecture (TriCore ELF files to the TriCore cores, an ARM ELF to the HSM, a .asm file to the MCS channels); \"cores\" limits it to the named cores (context ID or target name, * and ? as wildcards, e.g. \"tc37x.cpu0\", \"cpu0\" or \"mcs0.*\").",
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "path"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "description": "Path to the ELF file or GTM MCS assembler source (.asm)"
                        },
                        "cores": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Cores the file applies to (context ID or target name, * and ? as wildcards)"
                        }
                      }
                    }
                  ]
                }
              },
              "additionalAgentOptions": {
                "description": "Additional agent command-line options (appended as-is; default empty)",
                "type": "string",
                "default": ""
              },
              "liveWatchEnabled": {
                "description": "Refresh running global watch expressions during execution.",
                "type": "boolean",
                "default": true
              },
              "liveWatchIntervalMs": {
                "description": "Refresh interval in milliseconds for running global watch expressions. Minimum 200ms+ is recommended and enforced.",
                "type": "number",
                "default": 1000,
                "minimum": 200
              },
              "enableConsoleLog": {
                "description": "Show TCF protocol messages in the debug console",
                "type": "boolean",
                "default": false
              },
              "agentFlavor": {
                "description": "TCF agent type: 'infineon' (bundled DAS agent, default) or 'aurix-dbg' (OpenOCD-compatible server over Infineon TAS that runs OpenOCD cfg scripts)",
                "type": "string",
                "enum": [
                  "infineon",
                  "aurix-dbg"
                ],
                "default": "infineon"
              },
              "autoStartAgent": {
                "description": "Start the TCF agent process before connecting",
                "type": "boolean",
                "default": false
              },
              "agentPath": {
                "description": "Path to the agent executable (aurix-debugger.exe or aurix-dbg.exe)",
                "type": "string"
              },
              "host": {
                "description": "TCF host",
                "type": "string",
                "default": "127.0.0.1"
              },
              "port": {
                "description": "TCF port",
                "type": "number",
                "default": 1534
              },
              "searchDirs": {
                "description": "aurix-dbg: script search directories (OpenOCD -s), e.g. the OpenOCD tcl directory",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "configFiles": {
                "description": "aurix-dbg: OpenOCD configuration scripts (OpenOCD -f), in order",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "configCommands": {
                "description": "aurix-dbg: additional Tcl commands (OpenOCD -c), run after the configuration files",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "actions": {
                "description": "aurix-dbg: custom Tcl commands offered by the 'Debugger Actions' toolbar button. An entry with 'items' is a submenu, an entry with 'tcl' is an action.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Identifier for the command 'aurix-tcf.runAction' (e.g. keybindings with args { \"id\": \"...\" })"
                    },
                    "label": {
                      "type": "string",
                      "description": "Name shown in the action list"
                    },
                    "description": {
                      "type": "string",
                      "description": "Text shown next to the label"
                    },
                    "detail": {
                      "type": "string",
                      "description": "Text shown below the label"
                    },
                    "icon": {
                      "type": "string",
                      "description": "Codicon name, e.g. 'trash'"
                    },
                    "items": {
                      "type": "array",
                      "description": "Submenu entries (same format as 'actions')",
                      "items": {
                        "type": "object",
                        "required": [
                          "label"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Identifier for the command 'aurix-tcf.runAction'"
                          },
                          "label": {
                            "type": "string",
                            "description": "Name shown in the action list"
                          },
                          "description": {
                            "type": "string",
                            "description": "Text shown next to the label"
                          },
                          "detail": {
                            "type": "string",
                            "description": "Text shown below the label"
                          },
                          "icon": {
                            "type": "string",
                            "description": "Codicon name, e.g. 'trash'"
                          },
                          "items": {
                            "type": "array",
                            "description": "Submenu entries (same format as 'actions')"
                          },
                          "tcl": {
                            "type": [
                              "string",
                              "array"
                            ],
                            "items": {
                              "type": "string"
                            },
                            "description": "Tcl command(s) run in order on the debug server; stops at the first error"
                          },
                          "confirm": {
                            "type": "string",
                            "description": "Confirmation text shown before running"
                          },
                          "resetAfter": {
                            "type": "boolean",
                            "default": false,
                            "description": "Reset the target afterwards like the Reset toolbar button"
                          },
                          "showOutput": {
                            "type": "boolean",
                            "default": false,
                            "description": "Show the Tcl output in a notification (always written to the Debug Console)"
                          },
                          "timeout": {
                            "type": "number",
                            "default": 900,
