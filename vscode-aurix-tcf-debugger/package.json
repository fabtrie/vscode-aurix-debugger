		"debuggers": [
			{
				"type": "aurixdbg",
				"label": "AURIX™ Debugger",
				"configurationAttributes": {
					"launch": {
						"required": [],
						"properties": {
							"symbolFiles": {
								"description": "Symbol files: the application ELF plus e.g. bootmanager, FBL, HSM ELF files and GTM MCS assembler sources. Symbols only: they are never flashed (see flashFiles). Without \"cores\", a file applies to every core of its architecture (TriCore ELF files to the TriCore cores, an ARM ELF to the HSM, a .asm file to the MCS channels); \"cores\" limits it to the named cores (context ID or target name, * and ? as wildcards, e.g. \"tc37x.cpu0\", \"cpu0\" or \"mcs0.*\"). A path ending in \"@N\" or \"@N,M\" names the TriCore cores (core IDs) that run the ELF: its variables in core-local memory (DSPR/PSPR alias 0xD0000000/0xC0000000) are read from the first of them when evaluated on another core. The file still applies to the other cores.",
								"type": "array",
								"items": {
									"anyOf": [
										{
											"type": "string"
										},
										{
											"type": "object",
											"required": [
												"path"
											],
											"properties": {
												"path": {
													"type": "string",
													"description": "Path to the ELF file or GTM MCS assembler source (.asm), optionally with \"@N\" or \"@N,M\": the TriCore cores that run it"
												},
												"cores": {
													"type": "array",
													"items": {
														"type": "string"
													},
													"description": "Cores the file applies to (context ID or target name, * and ? as wildcards)"
												}
											}
										}
									]
								}
							},
							"flashFiles": {
								"description": "Images to program when enableFlashing is true or with the Flash Target toolbar button (ELF, Intel HEX or binary). The files are merged into one image first; where they overlap, later files win. Use the post-build HEX if the build patches CRCs or fills gaps after linking.",
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"enableFlashing": {
								"description": "If true, programs flashFiles with aurix-dbg's 'flash write_images' before the debug session, then resets the target (resetType, resetSuspend)",
								"type": "boolean",
								"default": false
							},
							"resetType": {
								"description": "ContextReset type used by the Reset and Flash Target toolbar buttons and after flashing (see the debug server's reset types). Falls back to 'reset' if this type fails.",
								"type": "string"
							},
							"resetSuspend": {
								"description": "If true, the target halts at the reset vector after a reset (Reset and Flash Target toolbar buttons, after flashing). If false, it runs after the reset; the toolbar buttons then pause all cores.",
								"type": "boolean",
								"default": false
							},
							"verifyFlash": {
								"description": "Read the programmed sectors back after flashing and compare them with the image (unchanged sectors are compared while flashing anyway).",
								"type": "boolean",
								"default": true
							},
							"workspace": {
								"description": "Workspace or project path",
								"type": "string"
							},
							"sourceFileMap": {
								"markdownDescription": "Maps source path prefixes in the debug information onto local folders, e.g. `{ \"c:/git/project\": \"${workspaceFolder}\" }` when a compiler cache (ccache) supplied objects built in another checkout. Applied before anything else, also when the original path exists. Breakpoints in mapped files are found in objects of either checkout.",
								"type": "object",
								"additionalProperties": {
									"type": "string"
								},
								"default": {}
							},
							"sourceSearchPaths": {
								"markdownDescription": "Folders searched for a source whose debug-information path does not exist: the path without its leading folders is tried under each folder (`c:/git/project/app/x.c` → `<folder>/project/app/x.c`, `<folder>/app/x.c`, …). The first hit is remembered as a mapping for the other files of that checkout. Default: `workspace` and the detected project root.",
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"device": {
