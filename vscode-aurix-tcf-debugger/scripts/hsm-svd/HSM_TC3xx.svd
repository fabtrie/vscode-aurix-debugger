    <peripheral>
      <name>HSM_TIM</name>
      <description>Timer module, timer 0 and timer 1 (HSM TS 7.4). 16-bit registers, addressed wordwise. Suspended in HALT mode.</description>
      <groupName>HSM</groupName>
      <baseAddress>0xEC000000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x100</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>HSM_TIM0</name>
        <description>Timer 0 overflow interrupt</description>
        <value>0</value>
      </interrupt>
      <interrupt>
        <name>HSM_TIM1</name>
        <description>Timer 1 overflow interrupt</description>
        <value>1</value>
      </interrupt>
      <registers>
        <register>
          <name>TIM_CTRL</name>
          <description>Timer Control Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TSRC1</name>
              <description>Timer 1 clock source (0-3)</description>
              <lsb>11</lsb>
              <msb>12</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>UNLOCK_TF1</name>
              <description>Write enable for TF1 in the same access. Reads as 0.</description>
              <lsb>10</lsb>
              <msb>10</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>TF1</name>
              <description>Timer 1 overflow flag</description>
              <lsb>9</lsb>
              <msb>9</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>TR1</name>
              <description>Timer 1 run</description>
              <lsb>8</lsb>
              <msb>8</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>TSRC0</name>
              <description>Timer 0 clock source (0-3)</description>
              <lsb>3</lsb>
              <msb>4</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>UNLOCK_TF0</name>
              <description>Write enable for TF0 in the same access. Reads as 0.</description>
              <lsb>2</lsb>
              <msb>2</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>TF0</name>
              <description>Timer 0 overflow flag</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>TR0</name>
              <description>Timer 0 run</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIM_CFG</name>
          <description>Timer Configuration Register (prescalers; change only while the timer is stopped)</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TPR_DIS1</name>
              <description>Timer 1 prescaler disable</description>
              <lsb>11</lsb>
              <msb>11</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>TPR1</name>
              <description>Timer 1 prescaler</description>
              <lsb>8</lsb>
              <msb>9</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIV4</name>
                  <description>4</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV16</name>
                  <description>16</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV64</name>
                  <description>64</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV512</name>
                  <description>512</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TPR_DIS0</name>
              <description>Timer 0 prescaler disable</description>
              <lsb>3</lsb>
              <msb>3</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>TPR0</name>
              <description>Timer 0 prescaler</description>
              <lsb>0</lsb>
              <msb>1</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIV4</name>
                  <description>4</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV16</name>
                  <description>16</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV64</name>
                  <description>64</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV512</name>
                  <description>512</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TIM_CNT0</name>
          <description>Timer counter 0 register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>COUNTER_VALUE</name>
              <description>Current counter value</description>
              <lsb>0</lsb>
              <msb>15</msb>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIM_CNT1</name>
          <description>Timer counter 1 register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>COUNTER_VALUE</name>
              <description>Current counter value</description>
              <lsb>0</lsb>
              <msb>15</msb>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIM_RLD0</name>
          <description>Timer reload 0 register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>RELOAD_VALUE</name>
              <description>Reload value</description>
              <lsb>0</lsb>
              <msb>15</msb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIM_RLD1</name>
          <description>Timer reload 1 register</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>RELOAD_VALUE</name>
              <description>Reload value</description>
              <lsb>0</lsb>
              <msb>15</msb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>HSM_WDT</name>
      <description>HSM watchdog timer (HSM TS 8.4). 16-bit registers, addressed wordwise. Suspended in HALT mode; its interrupt is the NMI.</description>
      <groupName>HSM</groupName>
      <baseAddress>0xEC000100</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x100</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>WDT_CTRL</name>
          <description>Watchdog Timer Control Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000C000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PERIOD</name>
              <description>Watchdog period</description>
              <lsb>12</lsb>
              <msb>15</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>INC_SRV</name>
              <description>Increment service</description>
              <lsb>8</lsb>
              <msb>8</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ISN</name>
                  <description>Service with 000AH</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IS1</name>
                  <description>Service value incremented with each access</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLK_SEL</name>
              <description>Clock select (stop the watchdog before changing)</description>
              <lsb>4</lsb>
              <msb>4</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_WDT</name>
              <description>Watchdog running</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_VAL</name>
          <description>Watchdog Timer Value Register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>WDT_VAL</name>
              <description>Current watchdog timer value</description>
              <lsb>0</lsb>
              <msb>15</msb>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_RELOAD</name>
          <description>Watchdog Timer Reload Register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>RELOAD_VAL</name>
              <description>Reload value</description>
              <lsb>0</lsb>
              <msb>15</msb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_SRV</name>
          <description>Watchdog Service Register. A wrong value triggers a checkpoint mismatch; do not update by read-increment-write.</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000A</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SRV_CNT</name>
              <description>Service counter</description>
              <lsb>0</lsb>
              <msb>11</msb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_SRV_INI</name>
          <description>Watchdog Service Initialization Register</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>SRV_CNT_INI</name>
              <description>Initial value of WDT_SRV</description>
              <lsb>0</lsb>
              <msb>11</msb>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_ACC_CTRL</name>
          <description>Watchdog Timer Access Control Register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000003</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DATA_ACC</name>
              <description>Level for the data registers</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PRIV</name>
                  <description>Privileged</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>USER</name>
                  <description>User</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CTRL_ACC</name>
              <description>Level for the control registers</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PRIV</name>
                  <description>Privileged</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>USER</name>
                  <description>User</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>HSM_TRNG</name>
      <description>True random number generator (HSM TS 3.4). Suspended in HALT mode.</description>
      <groupName>HSM</groupName>
      <baseAddress>0xEC000200</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x100</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>HSM_TRNG</name>
        <description>True random number generator interrupt</description>
        <value>2</value>
      </interrupt>
      <registers>
        <register>
          <name>TRNG_DATA32</name>
          <description>True RNG Data Register. A read consumes the random word (clears DTA_RDY), so it is not read automatically.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <readAction>modify</readAction>
          <fields>
            <field>
              <name>DATA</name>
              <description>Random data</description>
              <lsb>0</lsb>
              <msb>31</msb>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TRNG_STAT</name>
          <description>TRNG Status Register</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>UNLOCK_WARN</name>
              <description>Write enable for WARN in the same access. Reads as 0.</description>
              <lsb>10</lsb>
              <msb>10</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>WARN</name>
              <description>Quality warning</description>
              <lsb>9</lsb>
              <msb>9</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GOOD</name>
                  <description>No warning</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOW</name>
                  <description>Random data quality inadequate</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNLOCK_FIPS_ERR</name>
              <description>Write enable for FIPS_ERR in the same access. Reads as 0.</description>
              <lsb>3</lsb>
              <msb>3</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>FIPS_ERR</name>
              <description>FIPS error</description>
              <lsb>2</lsb>
              <msb>2</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OK</name>
                  <description>No error</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERROR</name>
                  <description>Data identical to the previous word</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTA_RDY</name>
              <description>Random data ready</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BUSY</name>
                  <description>No data</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RDY</name>
                  <description>Data ready</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TRNG_CTRL</name>
          <description>TRNG Control Register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DIS</name>
              <description>Disable (stops oscillators and logic)</description>
              <lsb>2</lsb>
              <msb>2</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>DBS</name>
              <description>Data block size</description>
              <lsb>0</lsb>
              <msb>1</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BYTE</name>
                  <description>8 bits</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HW</name>
                  <description>16 bits</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WORD</name>
                  <description>32 bits</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>HSM_CACHE</name>
      <description>HSM unified cache (HSM TS 2.5.3). Privileged access only. The command registers are write-only and trigger cache operations.</description>
      <groupName>HSM</groupName>
      <baseAddress>0xE008A000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x120</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CACHE_CONFIG</name>
          <description>Cache Configuration Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00060404</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SETBITS</name>
              <description>Number of set bits (2^SETBITS sets)</description>
              <lsb>16</lsb>
              <msb>23</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>WAYS</name>
              <description>Number of ways</description>
              <lsb>8</lsb>
              <msb>15</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>BLKBITS</name>
              <description>Number of block bits (04H: 16-byte lines)</description>
              <lsb>0</lsb>
              <msb>7</msb>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CACHE_CTRL</name>
          <description>Cache Control Register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DAPCA</name>
              <description>Disable parallel cache accesses</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EN</name>
                  <description>Parallel accesses possible</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <description>Parallel accesses disabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CACHE_AC</name>
          <description>Cache All Clean Register (write: clean and invalidate all blocks)</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MASK</name>
              <description>Mask</description>
              <lsb>0</lsb>
              <msb>31</msb>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CACHE_SC</name>
          <description>Cache Set Clean Register (write: clean the set of ADDR[9:4])</description>
          <addressOffset>0x104</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ADDR</name>
              <description>Set address</description>
              <lsb>0</lsb>
              <msb>31</msb>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CACHE_BC</name>
