        <description>PKC error interrupt</description>
        <value>9</value>
      </interrupt>
      <registers>
        <register>
          <name>PKC_CONFIG</name>
          <description>PKC Configuration Register (operand pointers into the SCM)</description>
          <addressOffset>0x0</addressOffset>
