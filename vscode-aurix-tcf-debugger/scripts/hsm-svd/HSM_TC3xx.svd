    <peripheral>
      <name>HSM_MPU</name>
      <description>Cortex-M3 memory protection unit, 8 regions (PMSAv7; C, S and TEX are ignored on the HSM, HSM TS 2.4).</description>
      <groupName>HSM</groupName>
      <baseAddress>0xE000ED90</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x2C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>TYPE</name>
          <description>MPU Type Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000800</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IREGION</name>
              <description>Instruction regions (0: unified)</description>
              <lsb>16</lsb>
              <msb>23</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>DREGION</name>
              <description>Number of regions</description>
              <lsb>8</lsb>
              <msb>15</msb>
