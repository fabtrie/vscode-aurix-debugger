                <enumeratedValue>
                  <name>OFB</name>
                  <description>OFB en-/decrypt</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CFB_ENC</name>
                  <description>CFB encrypt</description>
                  <value>6</value>
                </enumeratedValue>
