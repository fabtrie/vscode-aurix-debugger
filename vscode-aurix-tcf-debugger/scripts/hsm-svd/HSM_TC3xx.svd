              <lsb>10</lsb>
              <msb>10</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>VC_INTERR</name>
              <description>Vector catch exception entry/return fault</description>
              <lsb>9</lsb>
              <msb>9</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>VC_BUSERR</name>
              <description>Vector catch BusFault</description>
              <lsb>8</lsb>
              <msb>8</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>VC_STATERR</name>
              <description>Vector catch UsageFault state error</description>
              <lsb>7</lsb>
              <msb>7</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>VC_CHKERR</name>
              <description>Vector catch UsageFault check error</description>
              <lsb>6</lsb>
              <msb>6</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>VC_NOCPERR</name>
