              <msb>20</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>OPPTRB</name>
              <description>Pointer for operand B (PKC_SCM_Ri)</description>
              <lsb>8</lsb>
              <msb>12</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>OPPTRA</name>
              <description>Pointer for operand A (PKC_SCM_Ri)</description>
              <lsb>0</lsb>
              <msb>4</msb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PKC_CMD</name>
          <description>PKC Command Register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CALCR2</name>
              <description>Calculate R^2 mod N before the next operation (cleared by hardware)</description>
              <lsb>31</lsb>
              <msb>31</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>SIGNB</name>
              <description>Sign of parameter b in Y^2 = X^3 +- aX +- b (1: negative)</description>
              <lsb>30</lsb>
              <msb>30</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>SIGNA</name>
              <description>Sign of parameter a in Y^2 = X^3 +- aX +- b (1: negative)</description>
              <lsb>29</lsb>
              <msb>29</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>SIZE</name>
              <description>Operand size in multiples of 64 bits (1-4)</description>
              <lsb>8</lsb>
              <msb>15</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>FIELD</name>
              <description>Field</description>
              <lsb>7</lsb>
              <msb>7</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Z</name>
                  <description>Z or Z/p</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>F2X</name>
                  <description>F2[X] or F2[X]/(f)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TYPE</name>
              <description>Type of operation</description>
              <lsb>0</lsb>
              <msb>6</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ADDN</name>
                  <description>Modular addition</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SUBN</name>
                  <description>Modular subtraction</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MULTN</name>
                  <description>Modular multiplication</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RED</name>
                  <description>Modular reduction</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIVN</name>
                  <description>Modular division</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INV</name>
                  <description>Modular inversion</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MULT</name>
                  <description>Multiplication</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INV2</name>
                  <description>Modular inversion (n even)</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RED2</name>
                  <description>Modular reduction (n even)</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXP</name>
                  <description>Modular exponentiation</description>
                  <value>16</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PDBL</name>
                  <description>Point doubling</description>
                  <value>32</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PADD</name>
                  <description>Point addition</description>
                  <value>33</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SMULT</name>
                  <description>Scalar multiplication</description>
                  <value>34</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CHECKAB</name>
                  <description>Check parameters a, b</description>
                  <value>35</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CHECKN</name>
                  <description>Check order n</description>
                  <value>36</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CHECKPXY</name>
                  <description>Check point coordinates</description>
                  <value>37</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SMULT25519</name>
