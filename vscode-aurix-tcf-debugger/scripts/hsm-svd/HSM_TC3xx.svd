    <peripheral>
      <name>HSM_HASH</name>
      <description>Hash module MD5/SHA-1/SHA-224/SHA-256 (HSM TS 5.3). Only 32-bit accesses; reading a write-only register gives a bus error.</description>
      <groupName>HSM</groupName>
      <baseAddress>0xE8000400</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>HASH_CFG</name>
          <description>HASH Configuration Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>BEND_IN</name>
              <description>Input byte endianness</description>
              <lsb>7</lsb>
              <msb>7</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BIG</name>
                  <description>MSB left-most</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LIT</name>
                  <description>MSB right-most</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BEND_OUT</name>
              <description>Output byte endianness</description>
              <lsb>6</lsb>
              <msb>6</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BIG</name>
                  <description>MSB left-most</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LIT</name>
                  <description>MSB right-most</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ORDER_OUT</name>
              <description>Output word order</description>
              <lsb>4</lsb>
              <msb>4</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LSW_FIRST</name>
                  <description>Least significant word first</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MSW_FIRST</name>
                  <description>Most significant word first</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IV_MODE</name>
              <description>Initialization value mode</description>
              <lsb>3</lsb>
              <msb>3</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_IV</name>
                  <description>Default starting state</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>USE_IV</name>
                  <description>Start from HASH_IVIN value</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ALGO</name>
              <description>Hash algorithm</description>
              <lsb>0</lsb>
              <msb>1</msb>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NONE</name>
                  <description>No hash function</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MD5</name>
                  <description>MD-5</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHA1</name>
                  <description>SHA-1</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHA256</name>
                  <description>SHA-256</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HASH_STAT</name>
          <description>HASH Status Register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000004</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CNT</name>
              <description>Result counter: 32-bit words left in HASH_VAL</description>
              <lsb>8</lsb>
              <msb>11</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>DF_NF</name>
              <description>Data FIFO not full</description>
              <lsb>2</lsb>
              <msb>2</msb>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FIFO_FULL</name>
                  <description>FIFO full</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FIFO_NOTFULL</name>
                  <description>Data can be written</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IV_OK</name>
              <description>Initialization vector valid</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>BSY</name>
              <description>Busy flag</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HASH_IDLE</name>
                  <description>No operation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HASH_BUSY</name>
                  <description>Hashing or initialization ongoing</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HASH_IVIN</name>
          <description>Hash Initialization Value Register (consecutive writes; a read gives a bus error)</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>HASH_INIT_VEC</name>
              <description>Initialization value word</description>
              <lsb>0</lsb>
              <msb>31</msb>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HASH_VAL</name>
          <description>Hash Output Value Register. Each read returns the next result word and decrements HASH_STAT.CNT, so it is not read automatically.</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <readAction>modify</readAction>
          <fields>
            <field>
              <name>HASH_VAL</name>
              <description>Hash output word</description>
              <lsb>0</lsb>
              <msb>31</msb>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HASH_DATA</name>
          <description>Hash Data Input Register (fills the FIFO; a read gives a bus error)</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>HASH_DATA</name>
              <description>Input data word</description>
              <lsb>0</lsb>
              <msb>31</msb>
              <access>write-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>HSM_PKC</name>
      <description>Public Key Cryptography module, control and status (HSM TS 6.4.1). Only 32-bit accesses.</description>
      <groupName>HSM</groupName>
      <baseAddress>0xE8003C00</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x10</size>
