                  <name>GCM_ENC</name>
                  <description>GCM encrypt</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GCM_DEC</name>
                  <description>GCM decrypt</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GCM_MAC</name>
                  <description>G-hash input</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>XTS_ENC</name>
                  <description>XTS encrypt</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>XTS_DEC</name>
                  <description>XTS decrypt</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WK</name>
                  <description>Write input to key register KEYNR</description>
                  <value>16</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LK</name>
                  <description>Lock key register K0 or K1</description>
                  <value>17</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WCV</name>
                  <description>Write input to chaining variable CVNR</description>
                  <value>18</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RCV</name>
                  <description>Copy chaining variable CVNR to output</description>
                  <value>19</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>KEYNR</name>
              <description>Key number (0-7; 1FH = OLDKEY, key of the last operation)</description>
              <lsb>4</lsb>
              <msb>8</msb>
              <access>read-write</access>
            </field>
            <field>
              <name>CVNR</name>
              <description>Chaining variable number (0-4)</description>
              <lsb>0</lsb>
              <msb>2</msb>
              <access>read-write</access>
