    <peripheral>
      <name>HSM_FPB</name>
      <description>Cortex-M3 flash patch and breakpoint unit, 6 usable code comparators with the HSM's FP_COMPHx extension for 32-bit addresses (HSM TS 12.4.1). Used by the debug server for breakpoints; read-only here.</description>
      <groupName>HSM</groupName>
      <baseAddress>0xE0002000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>FP_CTRL</name>
          <description>Flash Patch Control Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>NUM_CODE2</name>
              <description>Code comparators, bits 6:4</description>
              <lsb>12</lsb>
              <msb>14</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>NUM_LIT</name>
              <description>Literal comparators</description>
              <lsb>8</lsb>
              <msb>11</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>NUM_CODE1</name>
              <description>Code comparators, bits 3:0</description>
              <lsb>4</lsb>
              <msb>7</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>KEY</name>
              <description>Write key (must be 1 on writes). Reads as 0.</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>ENABLE</name>
              <description>FPB enable</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FP_REMAP</name>
