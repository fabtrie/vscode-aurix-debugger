              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>T2CCU_CC2L</name>
          <description>T2CCU Capture/Compare Register 2 Low (SFR 0xC5, T2CCU_PAGE page 2, RMAP 0)</description>
          <addressOffset>0x14745</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
