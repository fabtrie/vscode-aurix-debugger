    <peripheral>
      <name>SCR_T01</name>
      <description>SCR Timer 0 and timer 1</description>
      <groupName>SCR</groupName>
      <baseAddress>0x00040000</baseAddress>
      <addressBlock>
        <offset>0x49</offset>
        <size>0x6</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>T01_TCON</name>
          <description>Timer 0/1 Control Register (SFR 0xC9)</description>
          <addressOffset>0x49</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>IT0</name>
              <description>External Interrupt 0 Level/Edge Trigger Control. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW_LEVEL_TRIGGERED_EXTERNAL</name>
                  <description>Low level triggered external interrupt 0 is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FALLING_EDGE_TRIGGERED_EXTERNAL</name>
                  <description>Falling edge triggered external interrupt 0 is selected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IE0</name>
              <description>External Interrupt 0 Flag. Set by hardware when external interrupt 0 event is detected. Cleared by hardware when the processor vectors to interrupt routine. Can also be set/cleared by software. [rwh]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IT1</name>
              <description>External Interrupt 1 Level/Edge Trigger Control. [rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW_LEVEL_TRIGGERED_EXTERNAL</name>
                  <description>Low level triggered external interrupt 1 is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FALLING_EDGE_TRIGGERED_EXTERNAL</name>
                  <description>Falling edge triggered external interrupt 1 is selected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IE1</name>
              <description>External Interrupt 1 Flag. Set by hardware when external interrupt 1 event is detected. Cleared by hardware when the processor vectors to interrupt routine. Can also be set/cleared by software. [rwh]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TR0</name>
              <description>Timer 0 Run Control. [rw]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TIMER_IS_HALTED</name>
                  <description>Timer is halted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER_RUNS</name>
                  <description>Timer runs</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TF0</name>
              <description>Timer 0 Overflow Flag. Set by hardware on Timer/Counter 0 overflow. Cleared by hardware when processor vectors to interrupt routine. Can also be set/cleared by software. [rwh]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TR1</name>
              <description>Timer 1 Run Control. Note:Timer 1 Run Control also affects TH0, if Timer 0 operates in Mode 3. [rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TIMER_IS_HALTED</name>
                  <description>Timer is halted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER_RUNS</name>
                  <description>Timer runs</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TF1</name>
              <description>Timer 1 Overflow Flag. Set by hardware on Timer/Counter 1 overflow. Cleared by hardware when processor vectors to interrupt routine. Can also be set/cleared by software. Note:TF1 is set by TH0 instead, if Timer 0 operates in Mode 3. [rwh]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>T01_TMOD</name>
          <description>Timer Mode Register (SFR 0xCA)</description>
          <addressOffset>0x4A</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>T0M</name>
              <description>Timer 0 Mode Select Bits. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TIMER_13B</name>
                  <description>13-bit timer (M8048 compatible mode)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER_16B</name>
                  <description>16-bit timer</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER_8B_AUTO_REL</name>
                  <description>8-bit auto-reload timer</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER0_SPLIT</name>
                  <description>Timer 0 is split into two halves. TL0 is an 8-bit timer controlled by the standard Timer 0 control bits, and TH0 is the other 8-bit timer controlled by the standard Timer 1 control bits. TH1 and TL1 of Timer 1 are held (Timer 1 is stopped).</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T0S</name>
              <description>Timer 0 Input Selector. [rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INPUT_IS_FROM_INTERNAL_SYSTEM</name>
                  <description>Input is from internal system clock</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INPUT_IS_FROM_T0_PIN</name>
                  <description>Input is from T0 pin</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GATE0</name>
              <description>Timer 0 Gate Control. [rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TIMER_0_WILL_ONLY_RUN_IF_TCON_TR0</name>
                  <description>Timer 0 will only run if TCON.TR0 = 1 (software control)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER_0_WILL_ONLY_RUN_IF_EXINT0</name>
                  <description>Timer 0 will only run if EXINT0 pin = 1 (hardware control) and TCON.TR0 is set</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T1M</name>
              <description>Timer 1 Mode Select Bits. [rw]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TIMER_13B</name>
                  <description>13-bit timer (M8048 compatible mode)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER_16B</name>
                  <description>16-bit timer</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER_8B_AUTO_REL</name>
                  <description>8-bit auto-reload timer</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER0_SPLIT</name>
                  <description>Timer 0 is split into two halves. TL0 is an 8-bit timer controlled by the standard Timer 0 control bits, and TH0 is the other 8-bit timer controlled by the standard Timer 1 control bits. TH1 and TL1 of Timer 1 are held (Timer 1 is stopped).</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T1S</name>
              <description>Timer 1 Input Selector. [rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INPUT_IS_FROM_INTERNAL_SYSTEM</name>
                  <description>Input is from internal system clock</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INPUT_IS_FROM_T1_PIN</name>
                  <description>Input is from T1 pin</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GATE1</name>
              <description>Timer 1 Gate Control. [rw]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TIMER_1_WILL_ONLY_RUN_IF_TCON_TR1</name>
                  <description>Timer 1 will only run if TCON.TR1 = 1 (software control)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER_1_WILL_ONLY_RUN_IF_EXINT1</name>
                  <description>Timer 1 will only run if EXINT1 pin = 1 (hardware control) and TCON.TR1 is set</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>T01_TL0</name>
          <description>Timer 0 Low Byte (SFR 0xCB)</description>
          <addressOffset>0x4B</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>VAL</name>
              <description>Timer 0 Low Byte Value. Note:If TMOD.T0M is equal to: 00B: TL0 holds the 5-bit prescaler value. 01B: TL0 holds the lower 8-bit part of the 16-bit timer value. 10B: TL0 holds the 8-bit timer value. 11B: TL0 holds the 8-bit timer value. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>T01_TL1</name>
          <description>Timer 1 Low Byte (SFR 0xCC)</description>
          <addressOffset>0x4C</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>VAL</name>
              <description>Timer 1 Low Byte Value. Note:If TMOD.T1M is equal to: 00B: TL1 holds the 5-bit prescaler value. 01B: TL1 holds the lower 8-bit part of the 16-bit timer value. 10B: TL1 holds the 8-bit timer value. 11B: TL1 is not used. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>T01_TH0</name>
          <description>Timer 0 High Byte (SFR 0xCD)</description>
          <addressOffset>0x4D</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>VAL</name>
              <description>Timer 0 High Byte Value. Note:If TMOD.T0M is equal to: 00B: TH0 holds the 8-bit prescaler value. 01B: TH0 holds the higher 8-bit part of the 16-bit timer value. 10B: TH0 holds the 8-bit reload value. 11B: TH0 holds the 8-bit timer value. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>T01_TH1</name>
          <description>Timer 1 High Byte (SFR 0xCE)</description>
          <addressOffset>0x4E</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>VAL</name>
              <description>Timer 1 High Byte Value. Note:If TMOD.T1M is equal to: 00B: TH1 holds the 8-bit prescaler value. 01B: TH1 holds the higher 8-bit part of the 16-bit timer value. 10B: TH1 holds the 8-bit reload value. 11B: TH1 is not used. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCR_T2CCU</name>
      <description>SCR Timer 2 and capture/compare unit</description>
      <groupName>SCR</groupName>
      <baseAddress>0x00040000</baseAddress>
      <addressBlock>
        <offset>0x47</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x4740</offset>
        <size>0x7</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xC740</offset>
        <size>0x7</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x14740</offset>
        <size>0x7</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x1C740</offset>
        <size>0x7</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x24742</offset>
        <size>0x2</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>T2CCU_PAGE</name>
          <description>Page Register for T2CCU (SFR 0xC7, RMAP 0)</description>
          <addressOffset>0x47</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xF7</resetMask>
          <fields>
            <field>
              <name>PAGE</name>
              <description>Page Bits. When written, the value indicates the new page address. When read, the value indicates the currently active page = addr[y:x+1]. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PAGE0</name>
                  <description>Selection is PAGE0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE1</name>
                  <description>Selection is PAGE1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE2</name>
                  <description>Selection is PAGE2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE3</name>
                  <description>Selection is PAGE3</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE4</name>
                  <description>Selection is PAGE4</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE5</name>
                  <description>Selection is PAGE5</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE6</name>
                  <description>Selection is PAGE6</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE7</name>
                  <description>Selection is PAGE7</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>STNR</name>
              <description>Storage Number. This number indicates which storage bitfield is the target of the operation defined by bit OP. If OP = 10B, the contents of PAGE are saved in STx before being overwritten with the new value. If OP = 11B, the contents of PAGE are overwritten by the contents of STx. The value written to bitfield PAGE is ignored. [w]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MOD_ST0</name>
                  <description>ST0 is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOD_ST1</name>
                  <description>ST1 is selected</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOD_ST2</name>
                  <description>ST2 is selected</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOD_ST3</name>
                  <description>ST3 is selected</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OP</name>
              <description>Operation. [w]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PAGE_MANUAL0</name>
                  <description>Manual page mode. The value of STNR is ignored and PAGE is directly written.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE_MANUAL1</name>
                  <description>Manual page mode. The value of STNR is ignored and PAGE is directly written</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE_SAVE</name>
                  <description>New page programming with automatic page saving. The value written to the bit positions of PAGE is stored. In parallel, the former contents of PAGE are saved in the storage bit field STx indicated by STNR.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE_RESTORE</name>
                  <description>Automatic restore page action. The value written to the bit positions PAGE is ignored and instead, PAGE is overwritten by the contents of the storage bit field STx indicated by STNR.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>T2_CON</name>
          <description>Timer 2 Control Register (SFR 0xC0, T2CCU_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x4740</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>CP_RL2</name>
              <description>Capture/Reload Select. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RELOAD_UPON_OVERFLOW_OR_UPON</name>
                  <description>Reload upon overflow or upon negative/positive transition at pin T2EX (when EXEN2 = 1)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CAPTURE_TIMER_2_DATA_REGISTER</name>
                  <description>Capture Timer 2 data register contents on the negative/positive transition at pin T2EX, provided EXEN2 = 1. The negative or positive transition at pin T2EX is selected by bit EDGESEL in register T2MOD.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>C_T2</name>
              <description>Timer or Counter Select. [rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TIMER_FUNCTION_SELECTED</name>
                  <description>Timer function selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COUNT_UPON_NEGATIVE_EDGE_AT_PIN</name>
                  <description>Count upon negative edge at pin T2</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TR2</name>
              <description>Timer 2 Run Control. This bit can be set or cleared by software to start or stop the timer T2. It can also be set by hardware via input T2EX, if bit T2MOD.T2RHEN is set to 1, or via a synchronized start with the CCT timer of the T2CCU. Note:Writing a one to this bit while the timer is running has no effect. [rwh]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TIMER_T2_IS_HALTED</name>
                  <description>Timer T2 is halted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER_T2_IS_RUNNING</name>
                  <description>Timer T2 is running</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXEN2</name>
              <description>Timer 2 External Enable Control. [rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXTERNAL_EVENTS_ARE_DISABLED</name>
                  <description>External events are disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTERNAL_EVENTS_ARE_ENABLED_IN</name>
                  <description>External events are enabled in Capture/Reload Mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXF2</name>
              <description>Timer 2 External Flag. In Capture/Reload Mode, this bit is set by hardware when a negative/positive transition occurs at pin T2EX, if bit EXEN2 = 1. This bit must be cleared by software. Note:When bit DCEN = 1 in auto-reload mode, no interrupt request to the core is generated. [rwh]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TF2</name>
              <description>Timer 2 Overflow/Underflow Flag. Set by a Timer 2 overflow/underflow. Must be cleared by software. [rwh]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>T2_MOD</name>
          <description>Timer 2 Mode Register (SFR 0xC1, T2CCU_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x4741</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>DCEN</name>
              <description>Up/Down Counter Enable. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UP_DOWN_COUNTER_FUNCTION_IS</name>
                  <description>Up/Down Counter function is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UP_DOWN_COUNTER_FUNCTION_IS_2</name>
                  <description>Up/Down Counter function is enabled and controlled by pin T2EX (Up = 1, Down = 0)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T2PRE</name>
              <description>Timer 2 Prescaler Bit. Selects the input clock for Timer 2 which is derived from the peripheral clock. [rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PCLK</name>
                  <description>fT2 = fPCLK</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PCLK_DIV2</name>
                  <description>fT2 = fPCLK / 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PCLK_DIV4</name>
                  <description>fT2 = fPCLK / 4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PCLK_DIV8</name>
                  <description>fT2 = fPCLK / 8</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PCLK_DIV16</name>
                  <description>fT2 = fPCLK / 16</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PCLK_DIV32</name>
                  <description>fT2 = fPCLK / 32</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PCLK_DIV64</name>
                  <description>fT2 = fPCLK / 64</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PCLK_DIV128</name>
                  <description>fT2 = fPCLK / 128</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PREN</name>
              <description>Prescaler Enable. [rw]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PRESCALER_IS_DISABLED_AND_THE_2</name>
                  <description>Prescaler is disabled, and the 2 or 12 divider takes effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRESCALER_IS_ENABLED_SEE_T2PRE</name>
                  <description>Prescaler is enabled (see T2PRE bit), and the 2 or 12 divider is bypassed</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EDGESEL</name>
              <description>Edge Select in Capture Mode/Reload Mode. [rw]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THE_FALLING_EDGE_AT_PIN_T2EX_IS</name>
                  <description>The falling edge at pin T2EX is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_RISING_EDGE_AT_PIN_T2EX_IS</name>
                  <description>The rising edge at pin T2EX is selected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T2RHEN</name>
              <description>Timer 2 External Start Enable. [rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TIMER_2_EXTERNAL_START_IS</name>
                  <description>Timer 2 External Start is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER_2_EXTERNAL_START_IS_ENABLED</name>
                  <description>Timer 2 External Start is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T2REGS</name>
              <description>Edge Select for Timer 2 External Start. [rw]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THE_FALLING_EDGE_AT_PIN_T2EX_IS</name>
                  <description>The falling edge at pin T2EX is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_RISING_EDGE_AT_PIN_T2EX_IS</name>
                  <description>The rising edge at Pin T2EX is selected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>T2_RC2L</name>
          <description>Timer 2 Reload/Capture Register, Low Byte (SFR 0xC2, T2CCU_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x4742</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>RC2</name>
              <description>Reload/Capture Value [7:0]. If T2_CON.CP_RL2 = 0, these contents are loaded into the timer register upon an overflow condition. If T2_CON.CP_RL2 = 1, this register is loaded with the current timer count upon a negative/positive transition at pin T2EX when EXEN2 = 1. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>T2_RC2H</name>
          <description>Timer 2 Reload/Capture Register, High Byte (SFR 0xC3, T2CCU_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x4743</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>RC2</name>
              <description>Reload/Capture Value [15:8]. If T2_CON.CP_RL2 = 0, these contents are loaded into the timer register upon an overflow condition. If T2_CON.CP_RL2 = 1, this register is loaded with the current timer count upon a negative/positive transition at pin T2EX when EXEN2 = 1. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>T2_T2L</name>
          <description>Timer 2, Low Byte (SFR 0xC4, T2CCU_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x4744</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>THL2</name>
              <description>Timer 2 Value [7:0]. These bits indicate the lower 8 bits of the current 16-bit timer value. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>T2_T2H</name>
          <description>Timer 2, High Byte (SFR 0xC5, T2CCU_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x4745</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>THL2</name>
              <description>Timer 2 Value [15:8]. These bits indicate the upper 8 bits of the current 16-bit timer value. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
