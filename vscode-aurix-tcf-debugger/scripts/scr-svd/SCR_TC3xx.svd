        <register>
          <name>T2CCU_CC2H</name>
          <description>T2CCU Capture/Compare Register 2 High (SFR 0xC6, T2CCU_PAGE page 2, RMAP 0)</description>
          <addressOffset>0x14746</addressOffset>
