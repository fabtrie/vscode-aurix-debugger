          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>ID</name>
              <description>CAN Identifier. Identifier of a standard message (ID[28:18]) or an extended message (ID[28:0]). For standard identifiers, bits ID[17:0] are &quot;don't care&quot;. This bitfield specifies ID15 to ID8. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_ID2_CTRL</name>
          <description>Message Identifier Control Register 2 (SFR 0xB2, WCAN_PAGE page 2, RMAP 0)</description>
          <addressOffset>0x13832</addressOffset>
