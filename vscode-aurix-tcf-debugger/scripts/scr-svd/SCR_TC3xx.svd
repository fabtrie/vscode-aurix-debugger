                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MRSTC</name>
                  <description>SSC Master Receiver Input MRSTC is selected</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SIS</name>
              <description>Slave Mode Receive Input Select. others, Reserved [rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MTSRA</name>
                  <description>SSC Slave Receiver Input MTSRA is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MTSRB</name>
                  <description>SSC Slave Receiver Input MTSRB is selected</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MTSRC</name>
                  <description>SSC Slave Receiver Input MTSRC is selected</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>MODPISEL5</name>
          <description>Peripheral Input Select Register 5 (SFR 0xF7, SCU_PAGE page 2, RMAP 0)</description>
          <addressOffset>0x17177</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0x0F</resetMask>
          <fields>
            <field>
              <name>T1IS</name>
              <description>Timer 1 Input Select. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>T1A</name>
                  <description>Timer 1 Input T1A is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>T1B</name>
                  <description>Timer 1 Input T1B is selected</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>T1C</name>
                  <description>Timer 1 Input T1C is selected</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESERVED</name>
                  <description>Reserved</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T0IS</name>
              <description>Timer 0 Input Select. [rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>T1A</name>
                  <description>Timer 0 Input T0A is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>T1B</name>
                  <description>Timer 0 Input T0B is selected</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>T1C</name>
                  <description>Timer 0 Input T0C is selected</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESERVED</name>
                  <description>Reserved</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DBG_MODSUSP</name>
          <description>Module Suspend Control Register (SFR 0xF9, SCU_PAGE page 2, RMAP 0)</description>
          <addressOffset>0x17179</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x01</resetValue>
          <resetMask>0x0F</resetMask>
          <fields>
            <field>
              <name>WDTSUSP</name>
              <description>SCU Watchdog Timer Debug Suspend Bit. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WDT_WILL_NOT_BE_SUSPENDED</name>
                  <description>WDT will not be suspended</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WDT_WILL_BE_SUSPENDED</name>
                  <description>WDT will be suspended</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RTCSUSP</name>
              <description>Real-Time Clock Debug Suspend Bit. [rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>REAL_TIME_CLOCK_WILL_NOT_BE</name>
                  <description>Real-Time clock will not be suspended</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REAL_TIME_CLOCK_WILL_BE_SUSPENDED</name>
                  <description>Real-Time clock will be suspended</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>T2SUSP</name>
              <description>Timer 2 Debug Suspend Bit. [rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TIMER_2_WILL_NOT_BE_SUSPENDED</name>
                  <description>Timer 2 will not be suspended</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER_2_WILL_BE_SUSPENDED</name>
                  <description>Timer 2 will be suspended</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CCTSUSP</name>
              <description>Compare/Capture Timer (CCT) Debug Suspend Bit. [rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CCT_WILL_NOT_BE_SUSPENDED</name>
                  <description>CCT will not be suspended</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
