    </peripheral>
    <peripheral>
      <name>SCR_WDT</name>
      <description>SCR Watchdog timer</description>
      <groupName>SCR</groupName>
      <baseAddress>0x00040000</baseAddress>
      <addressBlock>
        <offset>0x1</offset>
        <size>0x5</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>WDT_CON</name>
          <description>Watchdog Timer Control Register (SFR 0x81, RMAP 0)</description>
          <addressOffset>0x1</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0x3F</resetMask>
          <fields>
            <field>
              <name>WDTIN</name>
              <description>Watchdog Timer Input Frequency Selection. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INPUT_FREQUENCY_IS_FWDTCLK_2</name>
                  <description>Input frequency is fWDTCLK/2</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INPUT_FREQUENCY_IS_FWDTCLK_128</name>
                  <description>Input frequency is fWDTCLK/128</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WDTRS</name>
              <description>WDT Refresh Start. Active high. Set to start refresh operation on the watchdog timer. Cleared automatically by hardware after it is set by software. Takes 3 wdtclk cycles to take effect. Has higher priority than WDTEN. [rwh]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WDTEN</name>
              <description>WDT Enable. WDTEN is a protected bit. If the Protection Scheme is activated, then this bit cannot be written directly. See Section &quot;Miscellaneous Control&quot; for details on the protection scheme. Needs 3 wdtclk cycles to take effect. Has lower priority than WDTRS. Note:Clearing WDTEN bit to 0 during Prewarning Mode (WDTPR = 1) has no effect. [rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WDT_IS_DISABLED</name>
                  <description>WDT is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WDT_IS_ENABLED</name>
                  <description>WDT is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WDTCLK</name>
              <description>Watchdog Timer Clock Source Selection. [rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>V70_KHZ_CLOCK_IS_SELECTED</name>
                  <description>70 kHz clock is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V100_MHZ_DIV_CLOCK_IS_SELECTED</name>
                  <description>100 MHz/DIV clock is selected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WDTPR</name>
              <description>Watchdog Prewarning Mode Flag. This bit is set to 1 when a Watchdog error is detected. The Watchdog Timer has issued an NMI trap and is in Prewarning Mode. A reset of the chip occurs after the pre-warning period has expired. [rh]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL_MODE_DEFAULT_AFTER_RESET</name>
                  <description>Normal mode (default after reset)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_WATCHDOG_IS_OPERATING_IN</name>
                  <description>The Watchdog is operating in Prewarning Mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WINBEN</name>
              <description>Watchdog Window-Boundary Enable. [rw]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WATCHDOG_WINDOW_BOUNDARY_FEATURE</name>
                  <description>Watchdog Window-Boundary feature is disabled (default)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WATCHDOG_WINDOW_BOUNDARY_FEATURE_2</name>
                  <description>Watchdog Window-Boundary feature is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_REL</name>
          <description>Watchdog Timer Reload Register (SFR 0x82, RMAP 0)</description>
          <addressOffset>0x2</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>WDTREL</name>
              <description>Watchdog Timer Reload Value. Reload value for the high byte of the WDT. After writing WDTREL, it takes 3 fWDTCLK cycles to get WDTREL active. The delay has to be regarded for WDT enable and WDT refresh operation, as otherwise the previous WDTREL value is still active. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_WINB</name>
          <description>Watchdog Window-Boundary Register (SFR 0x83, RMAP 0)</description>
          <addressOffset>0x3</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>WDTWINB</name>
              <description>Watchdog Window-Boundary Value. This value is programmable. Within this Window-Boundary range from 0000H to (WDTWINB|00H), the WDT cannot do a refresh, else it will cause a WDTRST to be asserted. WDTWINB is compared to WDTH. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_L</name>
          <description>Watchdog Timer Low Byte (SFR 0x84, RMAP 0)</description>
          <addressOffset>0x4</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>WDT</name>
              <description>Watchdog Timer Current Value, low byte. [rh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_H</name>
          <description>Watchdog Timer High Byte (SFR 0x85, RMAP 0)</description>
          <addressOffset>0x5</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>WDT</name>
              <description>Watchdog Timer Current Value, high byte. [rh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCR_PORT</name>
      <description>SCR General purpose I/O ports SCR_P00 (P33.0-P33.7) and SCR_P01 (P34.1, P33.8-P33.15)</description>
      <groupName>SCR</groupName>
      <baseAddress>0x00040000</baseAddress>
      <addressBlock>
        <offset>0xF</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xF10</offset>
        <size>0xD</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x8F10</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x10F10</offset>
        <size>0xE</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>IO_PAGE</name>
          <description>Page Register for Port SFRs (SFR 0x8F, RMAP 0)</description>
          <addressOffset>0xF</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xF7</resetMask>
          <fields>
            <field>
              <name>PAGE</name>
              <description>Page Bits. When written, the value indicates the new page address. When read, the value indicates the currently active page = addr[y:x+1]. … [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PAGE0</name>
                  <description>ST0 is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE1</name>
                  <description>ST1 is selected</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE7</name>
                  <description>ST1 is selected</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>STNR</name>
              <description>Storage Number. This number indicates which storage bitfield is the target of the operation defined by bit OP. If OP = 10B, the contents of PAGE are saved in STx before being overwritten with the new value. If OP = 11B, the contents of PAGE are overwritten by the contents of STx. The value written to bitfield PAGE is ignored. [w]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MOD_ST0</name>
                  <description>ST0 is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOD_ST1</name>
                  <description>ST1 is selected</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOD_ST2</name>
                  <description>ST2 is selected</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOD_ST3</name>
                  <description>ST3 is selected</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OP</name>
              <description>Operation. [w]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PAGE_MANUAL0</name>
                  <description>Manual page mode. The value of STNR is ignored and PAGE is directly written.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE_MANUAL1</name>
                  <description>Manual page mode. The value of STNR is ignored and PAGE is directly written</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE_SAVE</name>
                  <description>New page programming with automatic page saving. The value written to the bit positions of PAGE is stored. In parallel, the former contents of PAGE are saved in the storage bit field STx indicated by STNR.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE_RESTORE</name>
                  <description>Automatic restore page action. The value written to the bit positions PAGE is ignored and instead, PAGE is overwritten by the contents of the storage bit field STx indicated by STNR.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>P00_OUT</name>
          <description>Port P00 Output Register (SFR 0x90, IO_PAGE page 0, RMAP 0)</description>
          <addressOffset>0xF10</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>P0</name>
              <description>Port n Output Bit 0. This bit determines the level at the output pin Pn.m if the output is selected as GPIO output. Pn.m can also be set or cleared by control bits of the SCR_P0n_OMSR, SCR_P0n_OMCR or SCR_P0n_OMTR registers. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THE_OUTPUT_LEVEL_OF_PN_M_IS_0</name>
                  <description>The output level of Pn.m is 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_OUTPUT_LEVEL_OF_PN_M_IS_1</name>
                  <description>The output level of Pn.m is 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>P1</name>
              <description>Port n Output Bit 1. This bit determines the level at the output pin Pn.m if the output is selected as GPIO output. Pn.m can also be set or cleared by control bits of the SCR_P0n_OMSR, SCR_P0n_OMCR or SCR_P0n_OMTR registers. [rwh]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THE_OUTPUT_LEVEL_OF_PN_M_IS_0</name>
                  <description>The output level of Pn.m is 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_OUTPUT_LEVEL_OF_PN_M_IS_1</name>
                  <description>The output level of Pn.m is 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>P2</name>
              <description>Port n Output Bit 2. This bit determines the level at the output pin Pn.m if the output is selected as GPIO output. Pn.m can also be set or cleared by control bits of the SCR_P0n_OMSR, SCR_P0n_OMCR or SCR_P0n_OMTR registers. [rwh]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THE_OUTPUT_LEVEL_OF_PN_M_IS_0</name>
                  <description>The output level of Pn.m is 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_OUTPUT_LEVEL_OF_PN_M_IS_1</name>
                  <description>The output level of Pn.m is 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>P3</name>
              <description>Port n Output Bit 3. This bit determines the level at the output pin Pn.m if the output is selected as GPIO output. Pn.m can also be set or cleared by control bits of the SCR_P0n_OMSR, SCR_P0n_OMCR or SCR_P0n_OMTR registers. [rwh]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THE_OUTPUT_LEVEL_OF_PN_M_IS_0</name>
                  <description>The output level of Pn.m is 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_OUTPUT_LEVEL_OF_PN_M_IS_1</name>
                  <description>The output level of Pn.m is 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>P4</name>
              <description>Port n Output Bit 4. This bit determines the level at the output pin Pn.m if the output is selected as GPIO output. Pn.m can also be set or cleared by control bits of the SCR_P0n_OMSR, SCR_P0n_OMCR or SCR_P0n_OMTR registers. [rwh]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THE_OUTPUT_LEVEL_OF_PN_M_IS_0</name>
                  <description>The output level of Pn.m is 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_OUTPUT_LEVEL_OF_PN_M_IS_1</name>
                  <description>The output level of Pn.m is 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>P5</name>
              <description>Port n Output Bit 5. This bit determines the level at the output pin Pn.m if the output is selected as GPIO output. Pn.m can also be set or cleared by control bits of the SCR_P0n_OMSR, SCR_P0n_OMCR or SCR_P0n_OMTR registers. [rwh]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
