    <peripheral>
      <name>SCR_RTC</name>
      <description>SCR Real-time clock</description>
      <groupName>SCR</groupName>
      <baseAddress>0x00040000</baseAddress>
      <addressBlock>
        <offset>0x61</offset>
        <size>0x9</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>RTC_CON</name>
          <description>Real-Time Clock Control Register (SFR 0xE1, RMAP 0)</description>
          <addressOffset>0x61</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>RTCC</name>
              <description>Real-Time Clock Start/Stop Control. This bit enables or disables the RTC. After software writes to this bit, it takes 6 RTC Clock cycles for the RTC to be actually enabled or disabled. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP_REAL_TIME_CLOCK_OPERATION</name>
                  <description>Stop Real-Time clock operation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>START_REAL_TIME_CLOCK_OPERATION</name>
                  <description>Start Real-Time clock operation</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RTCCLKSEL</name>
              <description>Real-Time Clock Input Clock Selection. Note:Real-Time clock must be in stop operation before the clock setting can be changed. Note:RTCCLKSEL must be cleared to 0 when the SCR is in standby mode and PCLK is 70 kHz, otherwise, the RTC counting will be disabled. [rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>V70_KHZ_CLOCK_IS_SELECTED</name>
                  <description>70 kHz clock is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PCLK_CLOCK_IS_SELECTED</name>
                  <description>PCLK clock is selected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RTPBYP</name>
              <description>Real-Time Clock 9-bit Prescaler Bypass. Note:Real-Time clock must be in stop operation before the clock setting can be changed. [rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>V9_BIT_PRESCALER_IS_NOT_BYPASSED</name>
                  <description>9-bit prescaler is not bypassed</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V9_BIT_PRESCALER_IS_BYPASSED</name>
                  <description>9-bit prescaler is bypassed</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RTCCT</name>
              <description>Real-Time Clock Capture Event Trigger. When set, this bit is held until the capture occurs, and then cleared by hardware. Software has to poll this bit until it is cleared to ensure that the capture has occured. [rwh]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_ACTION</name>
                  <description>No action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CAPTURE_EVENT_IS_TRIGGERED</name>
                  <description>Capture event is triggered</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ECRTC</name>
              <description>Real-Time Clock Compare Interrupt Enable. [rw]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE_REAL_TIME_CLOCK_COMPARE</name>
                  <description>Disable Real-Time clock compare interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE_REAL_TIME_CLOCK_COMPARE</name>
                  <description>Enable Real-Time clock compare interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RTC32SEL</name>
              <description>External Oscillator Selection (32 kHz / 32.768 kHz). Note:Real-Time clock must be in stop operation before the clock setting can be changed. RTC32SEL selects the external clock input. This clock input is on pin SCR_P01.2 (P33.10), and can be 32.768 kHz or 32 kHz . This bit is write protected by bit INIT32 in this register. Before writing to RTC32SEL, INIT32 has to be set. INIT32 has to be cleared after setting RTC32SEL. [rw]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXTERNAL_CLOCK_OSCILLATOR_INPUT</name>
                  <description>External clock oscillator input is not selected; internal clock as configured by RTCCLKSEL is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTERNAL_CLOCK_OSCILLATOR_INPUT_2</name>
                  <description>External clock oscillator input is selected for the RTC</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CFRTC</name>
              <description>Real-Time Clock Compare Flag. This bit is set by hardware when there is a compare match, and can only be cleared by software. A wake-up request is generated only if the SCR is in standby mode. Writing 0 clears CFRTC. Writing 1 has no effect. [rwh]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INIT32</name>
              <description>RTC32SEL Protection Bit. INIT32 is the protection bit for bit RTC_CON.RTC32SEL. To write RTC32SEL, INIT32 needs to be set. INIT32 has to be cleared after setting RTC32SEL. [rw]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RTC32SEL_NOT_WRITABLE</name>
                  <description>RTC32SEL not writable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RTC32SEL_IS_WRITABLE</name>
                  <description>RTC32SEL is writable</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RTC_CNT0</name>
          <description>Count Clock Register 0 (SFR 0xE2, RMAP 0)</description>
          <addressOffset>0x62</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>CNT_VAL</name>
              <description>Real-Time Clock Count Value. These bits represent the current 32-bit real-time clock value. The assignment is as follows: •RTC_CR3: Bits [31:24] •RTC_CR2: Bits [23:16] •RTC_CR1: Bits [15:8] •RTC_CR0: Bits [7:0] [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RTC_CNT1</name>
          <description>Count Clock Register 1 (SFR 0xE3, RMAP 0)</description>
          <addressOffset>0x63</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>CNT_VAL</name>
              <description>Real-Time Clock Count Value. These bits represent the current 32-bit real-time clock value. The assignment is as follows: •RTC_CR3: Bits [31:24] •RTC_CR2: Bits [23:16] •RTC_CR1: Bits [15:8] •RTC_CR0: Bits [7:0] [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RTC_CNT2</name>
          <description>Count Clock Register 2 (SFR 0xE4, RMAP 0)</description>
          <addressOffset>0x64</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>CNT_VAL</name>
              <description>Real-Time Clock Count Value. These bits represent the current 32-bit real-time clock value. The assignment is as follows: •RTC_CR3: Bits [31:24] •RTC_CR2: Bits [23:16] •RTC_CR1: Bits [15:8] •RTC_CR0: Bits [7:0] [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RTC_CNT3</name>
          <description>Count Clock Register 3 (SFR 0xE5, RMAP 0)</description>
          <addressOffset>0x65</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>CNT_VAL</name>
              <description>Real-Time Clock Count Value. These bits represent the current 32-bit real-time clock value. The assignment is as follows: •RTC_CR3: Bits [31:24] •RTC_CR2: Bits [23:16] •RTC_CR1: Bits [15:8] •RTC_CR0: Bits [7:0] [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RTC_CR0</name>
          <description>Real-Time Clock Compare/Capture Register 0 (SFR 0xE6, RMAP 0)</description>
          <addressOffset>0x66</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>CC_VAL</name>
              <description>Compare/Capture Value. These bits represent the 32-bit compare/capture value. The assignment is as follows: •RTC_CR3: Bits [31:24] •RTC_CR2: Bits [23:16] •RTC_CR1: Bits [15:8] •RTC_CR0: Bits [7:0] [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RTC_CR1</name>
          <description>Real-Time Clock Compare/Capture Register 1 (SFR 0xE7, RMAP 0)</description>
          <addressOffset>0x67</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>CC_VAL</name>
              <description>Compare/Capture Value. These bits represent the 32-bit compare/capture value. The assignment is as follows: •RTC_CR3: Bits [31:24] •RTC_CR2: Bits [23:16] •RTC_CR1: Bits [15:8] •RTC_CR0: Bits [7:0] [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RTC_CR2</name>
          <description>Real-Time Clock Compare/Capture Register 2 (SFR 0xE8, RMAP 0)</description>
          <addressOffset>0x68</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>CC_VAL</name>
              <description>Compare/Capture Value. These bits represent the 32-bit compare/capture value. The assignment is as follows: •RTC_CR3: Bits [31:24] •RTC_CR2: Bits [23:16] •RTC_CR1: Bits [15:8] •RTC_CR0: Bits [7:0] [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
