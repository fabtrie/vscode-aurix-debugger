            </field>
          </fields>
        </register>
        <register>
          <name>T2CCU_CCTDTCL</name>
          <description>T2CCU Capture/Compare Timer Dead-Time Control Register Low (SFR 0xC2, T2CCU_PAGE page 4, RMAP 0)</description>
          <addressOffset>0x24742</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>DTM</name>
              <description>Dead-Time Value. This 8-bit value defines the programmable delay between switching from the passive state to the active state of the selected outputs. The switching from the active state to the passive state is not delayed. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>T2CCU_CCTDTCH</name>
          <description>T2CCU Capture/Compare Timer Dead-Time Control Register High (SFR 0xC3, T2CCU_PAGE page 4, RMAP 0)</description>
          <addressOffset>0x24743</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>DTE0</name>
              <description>Dead-Time Enable for Channel Pair 0. Note:This bit shall only be set after enabling the corresponding channels in compare mode 0 with CCT timer as the time base. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DEAD_TIME_GENERATION_IS_DISABLED</name>
                  <description>Dead-time generation is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DEAD_TIME_GENERATION_IS_ENABLED</name>
                  <description>Dead-time generation is enabled for channel pair x. The corresponding outputs switch from the passive state to the active state (according to compare status) with the delay programmed in DTM.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTE1</name>
              <description>Dead-Time Enable for Channel Pair 1. Note:This bit shall only be set after enabling the corresponding channels in compare mode 0 with CCT timer as the time base. [rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DEAD_TIME_GENERATION_IS_DISABLED</name>
                  <description>Dead-time generation is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DEAD_TIME_GENERATION_IS_ENABLED</name>
                  <description>Dead-time generation is enabled for channel pair x. The corresponding outputs switch from the passive state to the active state (according to compare status) with the delay programmed in DTM.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTE2</name>
              <description>Dead-Time Enable for Channel Pair 2. Note:This bit shall only be set after enabling the corresponding channels in compare mode 0 with CCT timer as the time base. [rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DEAD_TIME_GENERATION_IS_DISABLED</name>
                  <description>Dead-time generation is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DEAD_TIME_GENERATION_IS_ENABLED</name>
                  <description>Dead-time generation is enabled for channel pair x. The corresponding outputs switch from the passive state to the active state (according to compare status) with the delay programmed in DTM.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTLEV</name>
              <description>Dead-Time Level. This bit defines the active level of all DTCx during dead-time counting. [rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW_SWITCHES_ARE_ACTIVE_HIGH</name>
                  <description>Low (switches are active high)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HIGH_SWITCHES_ARE_ACTIVE_LOW</name>
                  <description>High (switches are active low)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTR0</name>
              <description>Dead-Time Run Indication Bits. [rh]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THE_VALUE_OF_THE_CORRESPONDING</name>
                  <description>The value of the corresponding dead-time counter is 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_VALUE_OF_THE_CORRESPONDING_2</name>
                  <description>The value of the corresponding dead-time counter is not 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTR1</name>
              <description>Dead-Time Run Indication Bits. [rh]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THE_VALUE_OF_THE_CORRESPONDING</name>
                  <description>The value of the corresponding dead-time counter is 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_VALUE_OF_THE_CORRESPONDING_2</name>
                  <description>The value of the corresponding dead-time counter is not 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTR2</name>
              <description>Dead-Time Run Indication Bits. [rh]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THE_VALUE_OF_THE_CORRESPONDING</name>
                  <description>The value of the corresponding dead-time counter is 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_VALUE_OF_THE_CORRESPONDING_2</name>
                  <description>The value of the corresponding dead-time counter is not 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DTRES</name>
              <description>Reset Dead-Time Counters. On set, this bit is held for one PCLK, then cleared by hardware. Reading this bit always returns 0. [rwh]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_ACTION</name>
                  <description>No action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_THREE_DEAD_TIME_COUNTERS_ARE</name>
                  <description>The three dead-time counters are reset to 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCR_UART</name>
      <description>SCR Universal asynchronous receiver/transmitter (with LIN support)</description>
      <groupName>SCR</groupName>
      <baseAddress>0x00040000</baseAddress>
      <addressBlock>
        <offset>0x3A</offset>
        <size>0x6</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>UART_SCON</name>
          <description>Serial Channel Control Register (SFR 0xBA, RMAP 0)</description>
          <addressOffset>0x3A</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>RI</name>
              <description>Receive Interrupt Flag. This is set by hardware at the end of the 8th bit on mode 0, or at the half point of the stop bit in modes 1, 2, and 3. This bit can also be set by software. Must be cleared by software. Note:In case of an ongoing reception and a mode change at the very same time, the flag RI will have an undefined behaviour, as it is dependent from the point in time of the mode change. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TI</name>
              <description>Transmit Interrupt Flag. This is set by hardware at the end of the 8th bit in mode 0, or at the beginning of the stop bit in modes 1, 2, and 3. This bit can also be set by software. Must be cleared by software. Note:If a transmission has been started and TI is still 0, a further write to UART_SBUF will destroy the ongoing transmission. If TI is set to 1, the next transmission can be started. [rwh]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RB8</name>
              <description>Serial Port Receiver Bit 9. In modes 2 and 3, this is the 9th data bit received. In mode 1, this is the stop bit received. In mode 0, this bit is not used. [rwh]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TB8</name>
              <description>Serial Port Transmitter Bit 9. In modes 2 and 3, this is the 9th data bit sent. [rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>REN</name>
              <description>Enable Receiver of Serial Port. Note:The operating mode of the UART must not be changed while bit REN is set (or while a transmission is in progress). Before changing the mode of the UART, bit REN shall be cleared to 0. [rw]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SERIAL_RECEPTION_IS_DISABLED</name>
                  <description>Serial reception is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SERIAL_RECEPTION_IS_ENABLED</name>
                  <description>Serial reception is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SM2</name>
              <description>Enable Serial Port Multiprocessor Communication in Modes 2 and 3. In mode 2 or 3, if SM2 is set to 1, RI will not be activated if the received 9th data bit (RB8) is 0. In mode 1, if SM2 is set to 1, RI will not be activated if a valid stop bit (RB8) was not received. In mode 0, SM2 should be 0. Note:The operating mode of the UART must not be changed while bit REN is set or while a transmission is in progress. Before changing the mode of the UART, make sure that no transmissions are in progress, and that bit REN is cleared to 0. [rw]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SM01</name>
              <description>Serial Port Operating Mode Selection. Note:The operating mode of the UART must not be changed while bit REN is set or while a transmission is in progress. Before changing the mode of the UART, make sure that no transmissions are in progress, and that bit REN is cleared to 0. [rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MODE_0</name>
                  <description>8-bit shift register, fixed baud rate (fPCLK/2)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MODE_1</name>
                  <description>8-bit UART, variable baud rate</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MODE_2</name>
                  <description>9-bit UART, fixed baud rate (fPCLK/64 or fPCLK/32)</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MODE_3</name>
                  <description>9-bit UART, variable baud rate</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_SBUF</name>
          <description>Serial Data Buffer (SFR 0xBB, RMAP 0)</description>
          <addressOffset>0x3B</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>VAL</name>
              <description>Serial Interface Buffer Register. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_BGL</name>
          <description>Baudrate Timer/Reload Register, Low Byte (SFR 0xBC, RMAP 0)</description>
          <addressOffset>0x3C</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>FD_SEL</name>
              <description>Fractional Divider Selection. Selects the fractional divider to be n/32, where n is the value of FD_SEL, and is in the range of 0 to 31. For example, writing 0001B to FD_SEL selects the fractional divider to be 1/32. Note:Fractional divider has no effect if the 11-bit BR_VALUE = 000H. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BR_VALUE</name>
              <description>Baudrate Timer/Reload Value. The lower three bits of the 11-bit Baudrate Timer/Reload value. See also description in BGH register. Note:BR_VALUE shall be written if, and only if, BCON.R = 0. [rwh]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_BCON</name>
          <description>Baudrate Control Register (SFR 0xBD, RMAP 0)</description>
          <addressOffset>0x3D</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xDF</resetMask>
          <fields>
            <field>
              <name>R</name>
              <description>Baudrate Generator Run Control Bit. Note:BR_VALUE shall be written if, and only if, R = 0. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BAUDRATE_GENERATOR_DISABLED</name>
                  <description>Baudrate generator disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BAUDRATE_GENERATOR_ENABLED</name>
                  <description>Baudrate generator enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BRPRE</name>
              <description>Prescaler Bit. Selects the input clock for fDIV, which is derived from the peripheral clock. others, Reserved [rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIV</name>
                  <description>fDIV = fPCLK</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV2</name>
                  <description>fDIV = fPCLK / 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV4</name>
                  <description>fDIV = fPCLK / 4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV8</name>
                  <description>fDIV = fPCLK / 8</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV16</name>
                  <description>fDIV = fPCLK / 16</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV32</name>
                  <description>fDIV = fPCLK / 32</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BRDIS</name>
              <description>Baudrate Detection Disable. Note:It is recommended to toggle bit BRDIS after the reception of each LIN frame (complete or erroneous frame) to avoid a wrong Break field detection in noisy environments (i.e. spikes on the LIN bus). [rw]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BREAK_SYNC_DETECTION_IS_ENABLED</name>
                  <description>Break/Sync detection is enabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BREAK_SYNC_DETECTION_IS_DISABLED</name>
                  <description>Break/Sync detection is disabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BGSEL</name>
              <description>Baudrate Select for Detection. For different values of BGSEL, the baud rate range for detection is defined by the following formula: fpclk/(2184*2^BGSEL) &lt; baud rate range &lt; fpclk/(74*2^BGSEL); where BGSEL = 00B, 01B, 10B, 11B. See table &quot;BGSEL Bit Field Definition for Different Input Frequencies&quot; for bit field BGSEL definition for different input frequencies. [rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_LINST</name>
          <description>LIN Status Register (SFR 0xBE, RMAP 0)</description>
          <addressOffset>0x3E</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0x78</resetMask>
          <fields>
            <field>
              <name>BRK</name>
              <description>Break Field Flag. This bit is set by hardware and can only be cleared by software. [rwh]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BREAK_FIELD_IS_NOT_DETECTED</name>
                  <description>Break Field is not detected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BREAK_FIELD_IS_DETECTED</name>
                  <description>Break Field is detected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EOFSYN</name>
              <description>End of SYN Byte Interrupt Flag. This bit is set by hardware and can only be cleared by software. [rwh]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>END_OF_SYN_BYTE_IS_NOT_DETECTED</name>
                  <description>End of SYN Byte is not detected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>END_OF_SYN_BYTE_IS_DETECTED</name>
                  <description>End of SYN Byte is detected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ERRSYN</name>
              <description>SYN Byte Error Interrupt Flag. This bit is set by hardware and can only be cleared by software. [rwh]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ERROR_IS_NOT_DETECTED_IN_SYN_BYTE</name>
                  <description>Error is not detected in SYN Byte</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERROR_IS_DETECTED_IN_SYN_BYTE</name>
                  <description>Error is detected in SYN Byte</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYNEN</name>
              <description>End of SYN Byte and SYN Byte Error Interrupts Enable. [rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>END_OF_SYN_BYTE_AND_SYN_BYTE</name>
                  <description>End of SYN Byte and SYN Byte Error Interrupts are not enabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>END_OF_SYN_BYTE_AND_SYN_BYTE_2</name>
                  <description>End of SYN Byte and SYN Byte Error Interrupts are enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_BGH</name>
          <description>Baudrate Timer/Reload Register, High Byte (SFR 0xBF, RMAP 0)</description>
          <addressOffset>0x3F</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>BR_VALUE</name>
              <description>Baudrate Timer/Reload Value. The upper 8 bits of the 11-bit Baudrate Timer/Reload value. When the 11-bit BR_VALUE is 000H, the baudrate timer is bypassed. Note:BR_VALUE shall be written if, and only if, BCON.R = 0. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCR_SSC</name>
      <description>SCR Synchronous serial channel</description>
      <groupName>SCR</groupName>
      <baseAddress>0x00040000</baseAddress>
      <addressBlock>
        <offset>0x9</offset>
        <size>0x6</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>SSC_CONOL</name>
          <description>Control Register Low [Operation Mode] (SFR 0x89, RMAP 0)</description>
          <addressOffset>0x9</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>BC</name>
              <description>Bit Count Field. This field is loaded with the programmed data width value (BM) when the SSC is enabled. It then counts down with every shift bit. Note:This bit field is not to be written to. [rh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SSC_CONPL</name>
          <description>Control Register Low [Programming Mode] (SFR 0x89, RMAP 0)</description>
          <alternateRegister>SSC_CONOL</alternateRegister>
          <addressOffset>0x9</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>BM</name>
              <description>Data Width Selection. Note:The transfer and receive data width is maximum 8 bits. Transfer Data Width is 4...8 bits (&lt;BM&gt;+1). … [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RESERVED_DO_NOT_USE_THIS</name>
                  <description>Reserved. Do not use this combination.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESERVED_DO_NOT_USE_THIS_2</name>
                  <description>Reserved. Do not use this combination.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSFER_DATA_WIDTH_IS_4_BITS</name>
                  <description>Transfer Data Width is 4 bits</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSFER_DATA_WIDTH_IS_5_BITS</name>
                  <description>Transfer Data Width is 5 bits</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSFER_DATA_WIDTH_IS_6_BITS</name>
                  <description>Transfer Data Width is 6 bits</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSFER_DATA_WIDTH_IS_7_BITS</name>
                  <description>Transfer Data Width is 7 bits</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSFER_DATA_WIDTH_IS_8_BITS</name>
                  <description>Transfer Data Width is 8 bits</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HB</name>
              <description>Heading Control. [rw]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LSB_FIRST</name>
                  <description>Transmit/Receive LSB First</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MSB_FIRST</name>
                  <description>Transmit/Receive MSB First</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PH</name>
              <description>Clock Phase Control. [rw]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LATCH_ON_TRAILING_EDGE</name>
                  <description>Shift transmit data on the leading clock edge, latch on trailing edge.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LATCH_ON_LEADING_EDGE</name>
                  <description>Latch receive data on leading clock edge, shift on trailing edge.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PO</name>
              <description>Clock Polarity Control. [rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE_LOW</name>
                  <description>Idle clock line is low, leading clock edge is low-to-high transition.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IDLE_HIGH</name>
                  <description>Idle clock line is high, leading clock edge is high-to-low transition.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LB</name>
              <description>Loop Back Control. This bit shall be set by software only in Master mode. [rw]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL_OUTPUT</name>
                  <description>Normal output</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RECEIVE_INPUT_IS_CONNECTED_WITH</name>
                  <description>Receive input is connected with transmit output (half-duplex mode)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SSC_CONOH</name>
          <description>Control Register High [Operation Mode] (SFR 0x8A, RMAP 0)</description>
          <addressOffset>0xA</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x40</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>TE</name>
              <description>Transmit Error Flag. [rwh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_ERROR</name>
                  <description>No error</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSFER_STARTS_WITH_THE_SLAVE_S</name>
                  <description>Transfer starts with the slave's transmit buffer not being updated</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RE</name>
              <description>Receive Error Flag. [rwh]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_ERROR</name>
                  <description>No error</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RECEPTION_IN_FIFO_IS_BLOCKED</name>
                  <description>Reception in FIFO is blocked</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RFE</name>
              <description>Receive FIFO Buffer Empty Flag. [rh]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RECEIVE_FIFO_CONTAINS_DATA</name>
                  <description>Receive FIFO contains data</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RECEIVE_FIFO_IS_EMPTY</name>
                  <description>Receive FIFO is empty</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BE</name>
              <description>Baudrate Error Flag. [rwh]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_ERROR</name>
                  <description>No error</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MORE_THAN_FACTOR_2_OR_0_5_BETWEEN</name>
                  <description>More than factor 2 or 0.5 between slave's actual and expected baudrate</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BSY</name>
              <description>Busy Flag. Set while a transfer is in progress. Note: This bit is not to be written to. [rh]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_TRANSFER_IN_PROGRESS</name>
                  <description>No transfer in progress</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSFER_IN_PROGRESS</name>
                  <description>Transfer in progress</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RFF</name>
              <description>Receive FIFO Buffer Full Flag. Note:FIFO full will be deleted as soon as the receive buffer is read by software. [rh]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RECEIVE_FIFO_IS_NOT_FULL</name>
                  <description>Receive FIFO is not full</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RECEIVE_FIFO_IS_FULL</name>
                  <description>Receive FIFO is full</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MS</name>
              <description>Master Select. This bit shall not be modified during operation mode. [rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SLAVE_MODE_OPERATE_ON_SHIFT_CLOCK</name>
                  <description>Slave Mode. Operate on shift clock received via SCLK.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MASTER_MODE_GENERATE_SHIFT_CLOCK</name>
                  <description>Master Mode. Generate shift clock and output it via SCLK.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EN</name>
              <description>Enable Bit = 1 (needed for operating mode). Transmission and reception enabled. Access to status flags and M/S control. [rw]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SSC_CONPH</name>
          <description>Control Register High [Programming Mode] (SFR 0x8A, RMAP 0)</description>
          <alternateRegister>SSC_CONOH</alternateRegister>
          <addressOffset>0xA</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x40</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>TEN</name>
              <description>Transmit Error Enable. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IGNORE_TRANSMIT_ERRORS</name>
                  <description>Ignore transmit errors</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CHECK_TRANSMIT_ERRORS</name>
                  <description>Check transmit errors</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>REN</name>
              <description>Receive Error Enable. [rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IGNORE_RECEIVE_ERRORS</name>
                  <description>Ignore receive errors</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CHECK_RECEIVE_ERRORS</name>
                  <description>Check receive errors</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BEN</name>
              <description>Baudrate Error Enable. [rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IGNORE_BAUDRATE_ERRORS</name>
                  <description>Ignore baudrate errors</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CHECK_BAUDRATE_ERRORS</name>
                  <description>Check baudrate errors</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MS</name>
              <description>Master Select. This bit shall not be changed during operation mode. [rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SLAVE</name>
                  <description>Slave Mode. Operate on shift clock received via SCLK.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MASTER</name>
                  <description>Master Mode. Generate shift clock and output it via SCLK.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EN</name>
              <description>Enable Bit = 0 (needed for programming mode). Transmission and reception disabled. Access to control bits. [rw]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SSC_TBL</name>
          <description>Transmitter Buffer Register (SFR 0x8B, RMAP 0)</description>
          <addressOffset>0xB</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>TB_VALUE</name>
              <description>Transmit Data Register Value. TB_VALUE is the data value to be transmitted. Unselected bits of TB_VALUE are ignored during transmission. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SSC_RBL</name>
          <description>Receiver Buffer Register (SFR 0x8C, RMAP 0)</description>
          <addressOffset>0xC</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>RB_VALUE</name>
              <description>Receive Data Register Value. SSC_RBL contains the received data value RB_VALUE. Unselected bits of RB_VALUE will be not valid and should be ignored. Access point to FIFO. In case of FIFO overflow, the receive FIFO is blocked. [rh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SSC_BRL</name>
          <description>Baud Rate Timer Reload Register Low (SFR 0x8D, RMAP 0)</description>
          <addressOffset>0xD</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>BR_VALUE</name>
              <description>Baud Rate Timer Reload Register Value, low byte. Represents the lower 8 bits of the 16-bit baudrate reload value. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SSC_BRH</name>
          <description>Baud Rate Timer Reload Register High (SFR 0x8E, RMAP 0)</description>
          <addressOffset>0xE</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>BR_VALUE</name>
              <description>Baud Rate Timer Reload Register Value, high byte. Represents the upper 8 bits of the 16-bit baudrate reload value. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCR_ADCOMP</name>
      <description>SCR ADC comparator unit</description>
      <groupName>SCR</groupName>
      <baseAddress>0x00047100</baseAddress>
      <addressBlock>
        <offset>0x7A</offset>
        <size>0x2</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>ADCOMP_RES</name>
          <description>ADCOMP Result Register (SFR 0xFA, SCU_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x7A</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0xF0</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>ADRES</name>
              <description>ADC Conversion Result. This register shows the current converted ADC result. Software should ensure that the result is read before starting the next conversion. VIN = [LSB * (ADCRES-1)] ; LSB = 23.077 mV. Full Range : 5861.54 mV. For results of VIN =&lt; 1, VIN is set to 0 V. Otherwise, VIN = [LSB * (ADCRES-1)]. [rh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ADCOMP_CON</name>
          <description>ADCOMP Control Register (SFR 0xFB, SCU_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x7B</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x40</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>ADCENREQ</name>
              <description>ADC Comparator Enable Request. This bit activates the ADC unit, the associated bandgap and clock required for the ADC unit. It is required to wait some time for the units to start after the request. In case ADCENREQ is cleared during ongoing conversion, then the ADC is disabled when the currently running conversion is ended. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ADCOMP_UNIT_IS_DISABLED</name>
                  <description>ADCOMP unit is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ADCOMP_UNIT_IS_ENABLED</name>
                  <description>ADCOMP unit is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADCEN</name>
              <description>ADC Comparator Enable Status. This bit indicates that the ADC unit, the associated bandgap, and the clock required for the ADC unit are active, and a subsequent conversion can be triggered. It is set after some time after ADCOMP_CON.ANCENREQ is set. [rh]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ADCOMP_UNIT_IS_DISABLED</name>
                  <description>ADCOMP unit is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ADCOMP_UNIT_IS_ENABLED</name>
                  <description>ADCOMP unit is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADCIEN</name>
              <description>ADC Comparator Interrupt Enable. Software can read this bit to get the status whether the interrupt is currently enabled or disabled. [rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_INTERRUPT_IS_GENERATED</name>
                  <description>No interrupt is generated</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INTERRUPT_IS_GENERATED_AFTER</name>
                  <description>Interrupt is generated after conversion</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADCCHSEL</name>
              <description>ADC Channel Select. This bitfield selects the channel and configures the 4:1 ADC multiplexer before a conversion is triggered. After a channel is selected, adequate time needs to be provided for sampling before a conversion is started. [rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CH0</name>
                  <description>CH0 is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CH1</name>
                  <description>CH1 is selected</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CH2</name>
                  <description>CH2 is selected</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CH3</name>
                  <description>CH3 is selected</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>VF</name>
              <description>ADC Valid Flag for Result Register. Indicates a new result in ADCOMP_RES register. [rh]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THERE_IS_NO_VALID_RESULT</name>
                  <description>There is no valid result</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>A_NEW_RESULT_IS_AVAILABLE_IN_THE</name>
                  <description>A new result is available in the ADCOMP_RES result register. The valid flag is automatically cleared when bit SOC is set.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EOCSAMPLE</name>
              <description>ADC End of Conversion / Sampling Indication. This bit indicates that a conversion is completed and the result can be read. A new conversion via SOC can be started only when the EOC from the previous conversion has been set. This bit is automatically cleared when SOC is set. [rh]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ADC_CONVERSION_IS_CURRENTLY_GOING</name>
                  <description>ADC conversion is currently going on</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ADC_CONVERSION_IS_COMPLETED_ADC</name>
                  <description>ADC conversion is completed. ADC is currently sampling.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SOC</name>
              <description>ADC Start of Conversion Request. This bit activates a new conversion. Setting this bit has effect only when both, ADCEN and EOC, are set. This bit is automatically cleared by hardware once the conversion has started. If VF is set, setting SOC to 1 clears VF. [rwh]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ADC_CONVERSION_IS_NOT_STARTED</name>
                  <description>ADC conversion is not started</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ADC_CONVERSION_IS_STARTED</name>
                  <description>ADC conversion is started</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCR_WCAN</name>
      <description>SCR Wake-up CAN filter</description>
      <groupName>SCR</groupName>
      <baseAddress>0x00040000</baseAddress>
      <addressBlock>
        <offset>0x38</offset>
        <size>0x1</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x3830</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xB830</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x13830</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x1B830</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>WCAN_PAGE</name>
          <description>Page Register for WCAN (SFR 0xB8, RMAP 0)</description>
          <addressOffset>0x38</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xF7</resetMask>
          <fields>
            <field>
              <name>PAGE</name>
              <description>Page Bits. When written, the value indicates the new page address. When read, the value indicates the currently active page = addr[y:x+1]. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PAGE0</name>
                  <description>Selection is PAGE0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE1</name>
                  <description>Selection is PAGE1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE2</name>
                  <description>Selection is PAGE2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE3</name>
                  <description>Selection is PAGE3</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE4</name>
                  <description>Selection is PAGE4</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE5</name>
                  <description>Selection is PAGE5</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE6</name>
                  <description>Selection is PAGE6</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE7</name>
                  <description>Selection is PAGE7</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>STNR</name>
              <description>Storage Number. This number indicates which storage bitfield is the target of the operation defined by bit OP. If OP = 10B, the contents of PAGE are saved in STx before being overwritten with the new value. If OP = 11B, the contents of PAGE are overwritten by the contents of STx. The value written to bitfield PAGE is ignored. [w]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MOD_ST0</name>
                  <description>ST0 is selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOD_ST1</name>
                  <description>ST1 is selected</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOD_ST2</name>
                  <description>ST2 is selected</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOD_ST3</name>
                  <description>ST3 is selected</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OP</name>
              <description>Operation. [w]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PAGE_MANUAL0</name>
                  <description>Manual page mode. The value of STNR is ignored and PAGE is directly written.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE_MANUAL1</name>
                  <description>Manual page mode. The value of STNR is ignored and PAGE is directly written</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE_SAVE</name>
                  <description>New page programming with automatic page saving. The value written to the bit positions of PAGE is stored. In parallel, the former contents of PAGE are saved in the storage bit field STx indicated by STNR.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PAGE_RESTORE</name>
                  <description>Automatic restore page action. The value written to the bit positions PAGE is ignored and instead, PAGE is overwritten by the contents of the storage bit field STx indicated by STNR.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_CFG</name>
          <description>Wake-Up CAN Configuration Register (SFR 0xB0, WCAN_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x3830</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0x0D</resetMask>
          <fields>
            <field>
              <name>WCAN_EN</name>
              <description>WCAN Enable. This bit enables or disables the clock to WCAN Selective Wake-Up filter block. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE_CLOCK_TO_WCAN_SELECTIVE</name>
                  <description>Disable Clock to WCAN Selective Wake-Up filter block</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE_CLOCK_TO_WCAN_SELECTIVE</name>
                  <description>Enable Clock to WCAN Selective Wake-Up filter block</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SELWK_EN</name>
              <description>Selective Wake-Up Enable. The Selective Wake-up Enable function enables the protocol handler. The status of the protocol handler is also acknowledged through INTESTAT0.SWACK. The status of the Selective Wakeup Active is given in INTESTAT1.SWKSET. It also serves several functions when enabled. 1.Allows Wake-up source WUF to generate WUF_INT (see Figure &quot;Wake- up Frame Detection&quot;). 2.Allows error counter to generate ERROR_INT (see Figure &quot;Error Counter&quot;), indicated by INTESTAT0.ECOFL. 3.Triggers ERROR_INT and wake-up if there are any changes to the message object registers, indicated by INTESTAT0.MORC. 4.If a SYSERR occurs while SELWK_EN is enabled, then the Selective Wake-up function shall be disabled (ie., this bit field will be reset to 0). It is also indicated by INTESTAT0.ERSEL. [rwh]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SELECTIVE_WAKE_DISABLED</name>
                  <description>Selective wake disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SELECTIVE_WAKE_ENABLED</name>
                  <description>Selective wake enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CCE</name>
              <description>Configuration Change Enable. This bit field enables the configuration of the Bit Timing Registers. It also acts as soft-reset to the Selective Wake-up filter block. It has to be set back to '0' once the bit timing registers are modified for desired baudrate. [rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>THE_BIT_TIMING_REGISTERS_BTLN</name>
                  <description>The Bit Timing Registers (BTLn_CTRL), CDR Configuration registers (CDR_CTRL, CDR_UPPER_CTRL, CDR_LOWER_CTRL) and CAN_FD_CTRL may only be read. All attempts to modify them will be ignored.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THE_BIT_TIMING_REGISTERS_AND_CDR</name>
                  <description>The Bit Timing Registers and CDR Configuration registers may be read and written</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_INTMRSLT</name>
          <description>Wake-Up CAN Interrupt Mask Register (SFR 0xB1, WCAN_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x3831</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0x0F</resetMask>
          <fields>
            <field>
              <name>CANTOMASK</name>
              <description>CAN Time-Out Masking. This bit controls the interrupt masking for CANTO_INT interrupt. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CAN_TIME_OUT_IS_MASKED_NO</name>
                  <description>CAN Time-Out is masked - no interrupt is triggered</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CAN_TIME_OUT_IS_SIGNALED_AS_AN</name>
                  <description>CAN Time-Out is signaled as an interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ERRMASK</name>
              <description>SYSERR Masking. This bit controls the interrupt masking for SYSERR interrupt. [rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYSERR_IS_MASKED_NO_INTERRUPT_IS</name>
                  <description>SYSERR is masked - no interrupt is triggered</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSERR_IS_SIGNALED_AS_AN</name>
                  <description>SYSERR is signaled as an interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WUFMASK</name>
              <description>Wake-Up Frame Interrupt Masking. This bit controls the interrupt masking for WUF_INT interrupt. [rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WUF_INT_IS_MASKED_NO_INTERRUPT_IS</name>
                  <description>WUF_INT is masked - no interrupt is triggered</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WUF_INT_IS_SIGNALED_AS_AN</name>
                  <description>WUF_INT is signaled as an interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WUPMASK</name>
              <description>Wake-Up Pattern Detected Interrupt Masking. This bit controls the interrupt masking for WUP_INT interrupt. [rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WUP_INT_IS_MASKED_NO_INTERRUPT_IS</name>
                  <description>WUP_INT is masked - no interrupt is triggered</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WUP_INT_IS_SIGNALED_AS_AN</name>
                  <description>WUP_INT is signaled as an interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_CDR_CTRL</name>
          <description>CDR Control Register (SFR 0xB2, WCAN_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x3832</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x05</resetValue>
          <resetMask>0x0D</resetMask>
          <fields>
            <field>
              <name>CDREN</name>
              <description>Enable CDR. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE_CDR_INTERNAL_BIT_TIME</name>
                  <description>Disable CDR internal bit time measurement</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE_CDR_INTERNAL_BIT_TIME</name>
                  <description>Enable CDR internal bit time measurement</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ESF</name>
              <description>Error scaling factor. This bitfield defines the number of acquisition cycles on which average on error is calculated. [rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ERR_SCALE_FACT8</name>
                  <description>8</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERR_SCALE_FACT16</name>
                  <description>16 (recommended)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERR_SCALE_FACT32</name>
                  <description>32</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ADAPT_AVRGE</name>
                  <description>Adaptive averaging</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_CDR_UPPER_CTRL</name>
          <description>CDR Upper Limit Control Register (SFR 0xB3, WCAN_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x3833</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x69</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>UPPER</name>
              <description>CDR Upper Limit. This bitfield defines the upper limit for CDR internal bit time measurement. It should be configured as +5% of BTL1_CTRL value (integer part). [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_CDR_LOWER_CTRL</name>
          <description>CDR Lower Limit Control Register (SFR 0xB4, WCAN_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x3834</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x5F</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>LOWER</name>
              <description>CDR Lower Limit. This bitfield defines the lower limit for CDR internal bit time measurement. It should be configured as -5% of BTL1_CTRL value (integer part). [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_CDR_MEAS_HIGH</name>
          <description>CDR Measured High Register (SFR 0xB5, WCAN_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x3835</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x64</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>HIGH</name>
              <description>CDR Internally Measured High Value. This bitfield shows the internally measured duration of a CAN bus bit as number of fCAN clock cycles (integer part). [rh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_CDR_MEAS_LOW</name>
          <description>CDR Measured Low Register (SFR 0xB6, WCAN_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x3836</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <resetMask>0x3F</resetMask>
          <fields>
            <field>
              <name>LOW</name>
              <description>CDR Internally Measured Low Value. This bitfield shows the internally measured duration of a CAN bus bit as number of fCAN clock cycles (fractional part). [rh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_FD_CTRL</name>
          <description>CAN FD Control Register (SFR 0xB7, WCAN_PAGE page 0, RMAP 0)</description>
          <addressOffset>0x3837</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0x0F</resetMask>
          <fields>
            <field>
              <name>FDEN</name>
              <description>CAN FD Tolerant Enable. This bitfield enables or disables the CAN FD tolerant feature. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
                  <description>Disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLED</name>
                  <description>Enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FDFILT</name>
              <description>CAN FD Filter Time. This bitfield configures the filter time to detect the dominant bit field in FD phase. Refer to Table &quot;CAN FD dominant bit filter time&quot; for the FD filter time configuration for various baudrates. others, Reserved [rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>V13_130_NS</name>
                  <description>13 (130 ns)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V25_250_NS</name>
                  <description>25 (250 ns)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V48_480_NS</name>
                  <description>48 (480 ns)</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V90_900_NS</name>
                  <description>90 (900 ns)</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_INTESTAT0</name>
          <description>Wake-Up CAN Interrupt and Event Status Register 0 (SFR 0xB0, WCAN_PAGE page 1, RMAP 0)</description>
          <addressOffset>0xB830</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>SWACK</name>
              <description>Selective Wake-Up Enable Acknowledge. This bit field indicates the acknowledgement of protocol handler enabled/disabled. [rh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PROTOCOL_HANDLER_IS_DISABLED_AND</name>
                  <description>Protocol Handler is disabled and configuration of WUF is possible</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PROTOCOL_HANDLER_IS_ENABLED_AND</name>
                  <description>Protocol Handler is enabled and configuration of WUF should not be done</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MODE</name>
              <description>WCAN Mode of Operation. This bitfield indicates the WCAN mode of operation. [rh]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL_MODE</name>
                  <description>Normal Mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STANDBY_MODE</name>
                  <description>Standby Mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYSERR</name>
              <description>CAN Wake-Up System Error. The SYSERR indicates a configuration error (MORC), and an error counter overflow condition (ECOFL). [rh]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SELECTIVE_WAKE_MODE_IS_POSSIBLE</name>
                  <description>Selective Wake Mode is possible</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSTEM_ERROR_DETECTED_WCAN</name>
                  <description>System Error detected, WCAN enabling not possible. It also leads to SYSERR_INT interrupt trigger if enabled through ERRMASK.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CANTO</name>
              <description>CAN Time-Out Detection. This bit indicates that there was an inactive CAN bus on RXDCO pin within tSILENCE of 750 ms. See section &quot;CAN Message Timeout&quot;. A software write to INTESTATCLR0.CANTOCLR is required to reset this bit. [rh]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL_OPERATION</name>
                  <description>Normal operation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CAN_TIME_OUT_DETECTED_IT_ALSO</name>
                  <description>CAN Time-Out detected. It also leads to CANTO_INT interrupt if enabled through CANTOMASK.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ECOFL</name>
              <description>Error Counter Overflow. This bit field shows occurrence of Error Counter overflow. A set condition of this flag by hardware has higher priority than a clear through ECOFLCLR. [rh]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ERROR_COUNTER_HAS_NOT_OVERFLOWED</name>
                  <description>Error Counter has not overflowed (&amp;lt;= 31)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERROR_COUNTER_OVERFLOWED_GT_31</name>
                  <description>Error Counter overflowed (&amp;gt; 31)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MORC</name>
              <description>Message Object Register Changed. A set condition of this flag by hardware has higher priority than a clear through MORCCLR. [rh]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MESSAGE_OBJECT_REGISTERS_NOT</name>
                  <description>Message object registers not modified after SELWK_EN is set</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MESSAGE_OBJECT_REGISTERS_WAS</name>
                  <description>Message object registers was modified after SELWK_EN is set</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ERSEL</name>
              <description>Error Select. A set condition of this flag by hardware has higher priority than a clear through ERSELCLR. [rh]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYSERR_IS_NOT_SET_WHILE_SELWK_EN</name>
                  <description>SYSERR is not set while SELWK_EN is enabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSERR_IS_SET_WHILE_SELWK_EN_IS</name>
                  <description>SYSERR is set while SELWK_EN is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WUP</name>
              <description>Wake-Up Pattern Detected. This bit field is set when a falling edge on RXD (or WUP) is detected, when WCAN is in Standby mode. A software write to INTESTATCLR0.WUPCLR is required to clear this bit field. [rh]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WUP_NOT_DETECTED</name>
                  <description>WUP not detected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WUP_DETECTED_IT_ALSO_TRIGGERS_WUP</name>
                  <description>WUP detected. It also triggers WUP_INT interrupt when enabled through INTMRSLT.WUPMASK</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_INTESTAT1</name>
          <description>Wake-Up CAN Interrupt and Event Status Register 1 (SFR 0xB1, WCAN_PAGE page 1, RMAP 0)</description>
          <addressOffset>0xB831</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x60</resetValue>
          <resetMask>0x7F</resetMask>
          <fields>
            <field>
              <name>WUF</name>
              <description>Wake-Up Frame Detection (acc. ISO 11898-6). This bit shows the status whether a Wake-up Frame has been detected. [rh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_WAKE_UP_FRAME_DETECTED</name>
                  <description>No Wake-Up Frame detected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WAKE_UP_FRAME_DETECTED_IT_ALSO</name>
                  <description>Wake-Up Frame detected. It also leads to WUF_INT interrupt trigger if enabled through WUFMASK.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYNC</name>
              <description>Synchronisation (at least one CAN frame without fail must have been. received) This bit is set when a valid Classical CAN frame is detected and is updatedafter every received Classical CAN frame. This flag is not updated when aCAN FD frame is received. Clearing this flag through SYNCCLR has higherpriority than a set condition by hardware. [rh]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WCAN_FUNCTION_NOT_WORKING_OR_NOT</name>
                  <description>WCAN function not working or not synchronous to CAN bus</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VALID_CAN_FRAME_RECEIVED_WCAN</name>
                  <description>Valid CAN frame received, WCAN function is synchronous to CAN bus</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SWKSET</name>
              <description>Selective Wake Activity. [rh]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SELECTIVE_WAKE_IS_NOT_ACTIVE</name>
                  <description>Selective Wake is not active</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SELECTIVE_WAKE_IS_ACTIVATED</name>
                  <description>Selective Wake is activated</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CANSIL</name>
              <description>CAN Bus Silent Time during Selective Wake Operation. This bit is set if there is no activity on RXDC0 pin on the CAN bus after tSILENCE of 750 ms expired. If any activity is detected on the bus, this bit is reset automatically. tSILENCE is fixed at 750 ms. This bit can also be cleared through bit WCAN_INTESCLR.CANSILCLR. A set condition of this bit has higher priority than a clear through CANSILCLR. 0BtSILENCE not exceeded 1BtSILENCE is exceeded [rh]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FDF</name>
              <description>FD Frame Reception. This bit indicates reception of CAN FD frame. After reception of the CAN FD frame is completed, this bit is cleared to ‘0'. [rh]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_ACTION</name>
                  <description>No action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FD_FRAME_IS_BEING_RECEIVED</name>
                  <description>FD Frame is being received</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RXDF</name>
              <description>Filtered Receive Data Input. This bit shows the logic state of the filtered received data input signal (RXD_filt). [rh]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DOMINANT</name>
                  <description>Dominant</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RECESSIVE</name>
                  <description>Recessive</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RXDS</name>
              <description>Sampled Receive Data Input. This bit shows the logic state of the sampled received data input signal by the protocol handler. [rh]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DOMINANT</name>
                  <description>Dominant</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RECESSIVE</name>
                  <description>Recessive</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_FRMERRCNT</name>
          <description>Wake-Up CAN Error Counter Register (SFR 0xB2, WCAN_PAGE page 1, RMAP 0)</description>
          <addressOffset>0xB832</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>ECNT</name>
              <description>SWK CAN Frame Error Counter. If WCAN_FD_CTRL.FDEN = 0, the CAN Frame Error Counter is incremented when an error message or CAN FD frame is received, and decremented on a reception of a correct classical CAN frame, if ECNT&gt;0. If FDEN = 1, the behaviour of the error counter is based on FDEC_DIS bit configuration. See section &quot;Error Counter&quot;. [rh]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FDEC_DIS</name>
              <description>Error Count Disable on CAN FD Frame. This bit is used to describe the behaviour of the Error Counter for FD frames. The value of this bit has no effect if WCAN_FD_CTRL.FDEN = 0. Note:When an FD frame is detected, the error is checked only until the FDF bit of the FD frame. [rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ERROR_COUNTER_IS_INCREMENTED_OR</name>
                  <description>Error counter is incremented or decremented based on correctness of the bitfields in arbitration phase of the FD frame</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERROR_COUNTER_IS_ACTIVE_ONLY_FOR</name>
                  <description>Error counter is active only for Classical CAN frames, and it is frozen for CAN FD frames</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ECNTCLR</name>
              <description>Error Counter Clear Bit. Writing a 1 to this bit clears the error counter FRMERRCNT.ECNT. [w]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_INTESCLR0</name>
          <description>Wake-Up CAN Interrupt and Event Status Clear Register 0 (SFR 0xB3, WCAN_PAGE page 1, RMAP 0)</description>
          <addressOffset>0xB833</addressOffset>
          <size>8</size>
          <access>write-only</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFC</resetMask>
          <fields>
            <field>
              <name>SYSERRCLR</name>
              <description>CAN WUP System Error Clear Bit. Writing a 1 to this bit clears the corresponding status bit INTESTAT0.SYSERR. [w]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CANTOCLR</name>
              <description>CAN Time-Out Detection Clear Bit. Writing a 1 to this bit clears the corresponding status bit INTESTAT0.CANTO. [w]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>ECOFLCLR</name>
              <description>Error Counter Overflow Clear Bit. Writing a 1 to this bit clears the corresponding status bit INTESTAT0.ECOFL. [w]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>MORCCLR</name>
              <description>Message Object Register Changed Clear Bit. Writing a 1 to this bit clears the corresponding status bit INTESTAT0.MORC. [w]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>ERSELCLR</name>
              <description>Error Select Clear Bit. Writing a 1 to this bit clears the corresponding status bit INTESTAT0.ERSEL. [w]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>WUPCLR</name>
              <description>WUP Clear Bit. Writing a 1 to this bit clears the corresponding status bit INTESTAT0.WUP. [w]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_INTESCLR1</name>
          <description>Wake-Up CAN Interrupt and Event Status Clear Register 1 (SFR 0xB4, WCAN_PAGE page 1, RMAP 0)</description>
          <addressOffset>0xB834</addressOffset>
          <size>8</size>
          <access>write-only</access>
          <resetValue>0x00</resetValue>
          <resetMask>0x0B</resetMask>
          <fields>
            <field>
              <name>WUFCLR</name>
              <description>Wake-up Frame Detection Flag Clear Bit. Writing a 1 to this bit clears the corresponding status bit INTESTAT1.WUF. [w]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>SYNCCLR</name>
              <description>Synchronisation (at least one can frame without fail must have been. received) Clear Bit Writing a 1 to this bit clears the corresponding status bit INTESTAT1.SYNC. [w]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CANSILCLR</name>
              <description>CAN Silent Time during SWK Operation Clear Bit. Writing a 1 to this bit clears the corresponding status bit INTESTAT1.CANSIL. [w]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_BTL1_CTRL</name>
          <description>Bit Timing Logic 1 Control Register (SFR 0xB5, WCAN_PAGE page 1, RMAP 0)</description>
          <addressOffset>0xB835</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x64</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>TBIT</name>
              <description>Number of Time Quanta in a Bit Time. This bitfield represents the number of time quanta in a bit time. The time quanta is based on fCAN frequency. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_BTL2_CTRL</name>
          <description>Bit Timing Logic 2 Control Register (SFR 0xB6, WCAN_PAGE page 1, RMAP 0)</description>
          <addressOffset>0xB836</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x73</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>SP</name>
              <description>Sample Point Position. Represents the sample point position. The sample point position is calculated as given in section &quot;Filter and Sample Point Calculation&quot;. 33H represents the sample point position of 79.68 % (~80 %). The value shall be within 2CH to 38H (ie., 67.5 % to 87.5 %). [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BRP</name>
              <description>Baudrate Prescaler. This bitfield defines the scaling factor to derive one time-quanta. [rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIV1</name>
                  <description>Division by 1 (100 MHz)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV2</name>
                  <description>Division by 2 (50 MHz)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV4</name>
                  <description>Division by 4 (25 MHz)</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV8</name>
                  <description>Division by 8 (12.5 MHz)</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_DLC_CTRL</name>
          <description>Message Data Length Code Control Register (SFR 0xB7, WCAN_PAGE page 1, RMAP 0)</description>
          <addressOffset>0xB837</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0x0F</resetMask>
          <fields>
            <field>
              <name>DLC</name>
              <description>Data Length Code. Valid values for the data length are 0 to 8. DLC &gt; 8 will be considered as 8 data bytes, but the truncation will not be visible in this bitfield upon read. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_ID0_CTRL</name>
          <description>Message Identifier Control Register 0 (SFR 0xB0, WCAN_PAGE page 2, RMAP 0)</description>
          <addressOffset>0x13830</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>ID</name>
              <description>CAN Identifier. Identifier of a standard message (ID[28:18]) or an extended message (ID[28:0]). For standard identifiers, bits ID[17:0] are &quot;don't care&quot;. This bitfield specifies ID7 to ID0. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_ID1_CTRL</name>
