              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_ID3_CTRL</name>
          <description>Message Identifier Control Register 3 (SFR 0xB3, WCAN_PAGE page 2, RMAP 0)</description>
          <addressOffset>0x13833</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0x7D</resetMask>
          <fields>
            <field>
              <name>IDE</name>
              <description>Identified Extension Bit. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STANDARD_FRAME_WITH_11_BITS</name>
                  <description>Standard frame with 11 bits identified</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTENDED_FRAME_WITH_29_BITS</name>
                  <description>Extended frame with 29 bits identified</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ID</name>
              <description>CAN Identifier. Identifier of a standard message (ID[28:18]) or an extended message (ID[28:0]). For standard identifiers, bits ID[17:0] are &quot;don't care&quot;. This bitfield specifies ID28 to ID24. [rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCAN_MASK_ID0_CTRL</name>
          <description>Message Identifier Mask Register 0 (SFR 0xB4, WCAN_PAGE page 2, RMAP 0)</description>
          <addressOffset>0x13834</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <resetMask>0xFF</resetMask>
          <fields>
            <field>
              <name>MID</name>
              <description>Mask for Message Identifier. Mask to filter incoming messages with standard identifiers (MID[28:18]) or extended identifiers (MID[28:0]). For standard identifiers, bits MID[17:0] are &quot;don't care&quot;. If a specific bit in MID is set, the corresponding bit in the ID is considered for the ID matching evaluation, otherwise it is considered as &quot;don't care&quot;. This bitfield specifies MID7 to MID0. [rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
